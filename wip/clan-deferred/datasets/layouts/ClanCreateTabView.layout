     text "Clans that invited you. Invites expire 7 days after sending."
    }
    ScrollWidgetClass invitesScroll {
     position 0.02 0.18
     hexactpos 0
     vexactpos 0
     size 0.96 0.8
     hexactsize 0
     vexactsize 0
     "Scrollbar V" 1
     {
      GridSpacerWidgetClass invitesList {
       size 1 60
       hexactsize 0
       vexactsize 1
       ignorepointer 1
       "Size To Content V" 1
       Columns 1
       Rows 10
       Margin 2
       scriptclass "ComponentWidgetBinding"
       {
        ScriptParamsClass {
         Component_ForEach "{{ _incomingInvites }}"
         Component_Template "txb-clan-invite-row"
         Component_ItemProperty "_inputInvite"
        }
       }
      }
      TextWidgetClass invitesEmpty {
       position 0.05 0.4
       hexactpos 0
       vexactpos 0
       size 0.9 0.1
       hexactsize 0
