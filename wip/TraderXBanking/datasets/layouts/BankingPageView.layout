FrameWidgetClass rootFrame {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 halign center_ref
 valign center_ref
 {
  PanelWidgetClass bankingRoot {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 0.96 0.92
   hexactsize 0
   vexactsize 0
   halign center_ref
   valign center_ref
   color 0.8 0.8 0.8 1
   style TXContainer
   {
    PanelWidgetClass headerBar {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 0.09
     hexactsize 0
     vexactsize 0
     color 0.9961 0.9961 0.9961 1
     ignorepointer 1
     style TXHeader
     {
      PanelWidgetClass identityPanel {
       position 0.02 0
       hexactpos 0
       vexactpos 0
       size 0.22 1
       hexactsize 0
       vexactsize 0
       ignorepointer 1
       {
        TextWidgetClass bankerName {
         position 0 0.15
         hexactpos 0
         vexactpos 0
         size 1 0.45
         hexactsize 0
         vexactsize 0
         "text color" 0.8314 0.6431 0.298 1
         font "gui/fonts/etelkatextpro28"
         ignorepointer 1
         "exact text" 1
         style Bold
         text "Banker"
         scriptclass "TextBinding"
         {
          ScriptParamsClass {
           Binding_Expression "{{ bankerName }}"
          }
         }
        }
        TextWidgetClass bankerRole {
         position 0 0.6
         hexactpos 0
         vexactpos 0
         size 1 0.3
         hexactsize 0
         vexactsize 0
         "text color" 0.6039 0.5804 0.5333 1
         font "gui/fonts/etelkatextpro12"
         ignorepointer 1
         "exact text" 1
         text "BANKING · BANK TELLER"
        }
       }
      }
      GridSpacerWidgetClass tabNavGrid {
       position 0.22 0.25
       hexactpos 0
       vexactpos 0
       size 0.7 0.5
       hexactsize 0
       vexactsize 0
       ignorepointer 1
       Columns 6
       Rows 1
       Margin 4
       {
        ButtonWidgetClass tabHome {
         color 0.9961 0.9961 0.9961 1
         "text color" 0.8471 0.8235 0.7529 1
         font "gui/fonts/etelkatextpro14"
         "exact text" 1
         style Bold
         style TXTab
         text "HOME"
         scriptclass "NavButtonBinding"
         {
          ScriptParamsClass {
           TargetSelector "banking-home-tab"
          }
         }
        }
        ButtonWidgetClass tabAccount {
         color 0.9961 0.9961 0.9961 1
         "text color" 0.8471 0.8235 0.7529 1
         font "gui/fonts/etelkatextpro14"
         "exact text" 1
         style Bold
         style TXTab
         text "ACCOUNT"
         scriptclass "NavButtonBinding"
         {
          ScriptParamsClass {
           TargetSelector "banking-account-tab"
          }
         }
        }
        ButtonWidgetClass tabVault {
         color 0.9961 0.9961 0.9961 1
         "text color" 0.8471 0.8235 0.7529 1
         font "gui/fonts/etelkatextpro14"
         "exact text" 1
         style Bold
         style TXTab
         text "VAULT"
         scriptclass "NavButtonBinding"
         {
          ScriptParamsClass {
           TargetSelector "banking-vault-tab"
          }
         }
        }
        ButtonWidgetClass tabTransfer {
         color 0.9961 0.9961 0.9961 1
         "text color" 0.8471 0.8235 0.7529 1
         font "gui/fonts/etelkatextpro14"
         "exact text" 1
         style Bold
         style TXTab
         text "TRANSFER"
         scriptclass "NavButtonBinding"
         {
          ScriptParamsClass {
           TargetSelector "banking-transfer-tab"
          }
         }
        }
        ButtonWidgetClass tabClan {
         color 0.9961 0.9961 0.9961 1
         "text color" 0.8471 0.8235 0.7529 1
         font "gui/fonts/etelkatextpro14"
         "exact text" 1
         style Bold
         style TXTab
         text "CLAN"
         scriptclass "NavButtonBinding"
         {
          ScriptParamsClass {
           TargetSelector "banking-clan-tab"
          }
         }
        }
        ButtonWidgetClass tabLedger {
         color 0.9961 0.9961 0.9961 1
         "text color" 0.8471 0.8235 0.7529 1
         font "gui/fonts/etelkatextpro14"
         "exact text" 1
         style Bold
         style TXTab
         text "LEDGER"
         scriptclass "NavButtonBinding"
         {
          ScriptParamsClass {
           TargetSelector "txb-ledger-tab"
          }
         }
        }
       }
      }
      ButtonWidgetClass tabLeave {
       position 0.95 0.25
       hexactpos 0
       vexactpos 0
       size 0.03 0.5
       hexactsize 0
       vexactsize 0
       color 0.9961 0.9961 0.9961 1
       "text color" 1 1 1 1
       font "gui/fonts/etelkatextpro22"
       "exact text" 1
       style Bold
       style TXBtnLeave
       text "X"
       scriptclass "ButtonBinding"
       {
        ScriptParamsClass {
         OnClick "OnClose"
        }
       }
      }
     }
    }
    PanelWidgetClass subnav {
     position 0 0.09
     hexactpos 0
     vexactpos 0
     size 1 0.03
     hexactsize 0
     vexactsize 0
     color 0.9961 0.9961 0.9961 1
     ignorepointer 1
     style TXSurface
     {
      TextWidgetClass subnavLeft {
       position 0.02 0
       hexactpos 0
       vexactpos 0
       size 0.6 1
       hexactsize 0
       vexactsize 0
       "text color" 0.6039 0.5804 0.5333 1
       font "gui/fonts/etelkatextpro12"
       ignorepointer 1
       "exact text" 1
       "text valign" center
       text "SVETLOYARSK · CENTRAL BANK BRANCH"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ subnavContext }}"
        }
       }
      }
      PanelWidgetClass onlinePill {
       position 0.86 0.2
       hexactpos 0
       vexactpos 0
       size 0.05 0.6
       hexactsize 0
       vexactsize 0
       color 0.9961 0.9961 0.9961 1
       ignorepointer 1
       style TXSuccessBox
       {
        TextWidgetClass onlinePillText {
         position 0 0
         hexactpos 0
         vexactpos 0
         size 1 1
         hexactsize 0
         vexactsize 0
         "text color" 0.6039 0.6902 0.3529 1
         font "gui/fonts/etelkatextpro12"
         ignorepointer 1
         "exact text" 1
         "text halign" center
         "text valign" center
         style Bold
         text "● ONLINE"
        }
       }
      }
      PanelWidgetClass feePill {
       position 0.92 0.2
       hexactpos 0
       vexactpos 0
       size 0.05 0.6
       hexactsize 0
       vexactsize 0
       color 0.9961 0.9961 0.9961 1
       ignorepointer 1
       style TXCardElevated
       {
        TextWidgetClass feePillText {
         position 0 0
         hexactpos 0
         vexactpos 0
         size 1 1
         hexactsize 0
         vexactsize 0
         "text color" 0.6039 0.5804 0.5333 1
         font "gui/fonts/etelkatextpro12"
         ignorepointer 1
         "exact text" 1
         "text halign" center
         "text valign" center
         style Bold
         text "FEE 2%"
         scriptclass "TextBinding"
         {
          ScriptParamsClass {
           Binding_Expression "{{ feesText }}"
          }
         }
        }
       }
      }
     }
    }
    PanelWidgetClass tabDivider {
     position 0 0.12
     hexactpos 0
     vexactpos 0
     size 1 0
     hexactsize 0
     vexactsize 0
     color 0.9961 0.9961 0.9961 1
     ignorepointer 1
     style TXDivider
    }
    PanelWidgetClass tabContent {
     position 0 0.13
     hexactpos 0
     vexactpos 0
     size 1 0.87
     hexactsize 0
     vexactsize 0
     clipchildren 1
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_Selector "{{ current_tab }}"
      }
     }
    }
   }
  }
 }
}