PanelWidgetClass ledgerRowRoot {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 color 0.9961 0.9961 0.9961 1
 style TXSurface
 {
  ButtonWidgetClass rowClickBtn {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   color 0 0 0 0
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnRowClicked"
    }
   }
  }
  TextWidgetClass rowDate {
   position 0.02 0
   hexactpos 0
   vexactpos 0
   size 0.12 1
   hexactsize 0
   vexactsize 0
   "text color" 0.4157 0.3961 0.3765 1
   font "gui/fonts/etelkatextpro12"
   ignorepointer 1
   "exact text" 1
   "text valign" center
   text "—"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ rowDateText }}"
    }
   }
  }
  TextWidgetClass rowType {
   position 0.15 0
   hexactpos 0
   vexactpos 0
   size 0.48 1
   hexactsize 0
   vexactsize 0
   "text color" 0.8471 0.8235 0.7529 1
   font "gui/fonts/etelkatextpro12"
   ignorepointer 1
   "exact text" 1
   "text valign" center
   text "—"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ rowTypeText }}"
    }
   }
  }
  TextWidgetClass rowAmount {
   position 0.65 0
   hexactpos 0
   vexactpos 0
   size 0.15 1
   hexactsize 0
   vexactsize 0
   "text color" 0.8471 0.8235 0.7529 1
   font "gui/fonts/etelkatextpro12"
   ignorepointer 1
   "exact text" 1
   "text halign" right
   "text valign" center
   style Bold
   text "—"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ rowAmountText }}"
    }
   }
  }
  TextWidgetClass rowBalance {
   position 0.82 0
   hexactpos 0
   vexactpos 0
   size 0.15 1
   hexactsize 0
   vexactsize 0
   "text color" 0.4157 0.3961 0.3765 1
   font "gui/fonts/etelkatextpro12"
   ignorepointer 1
   "exact text" 1
   "text halign" right
   "text valign" center
   text "—"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ rowBalanceText }}"
    }
   }
  }
 }
}