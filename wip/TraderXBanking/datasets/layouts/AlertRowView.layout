PanelWidgetClass alertRowRoot {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 color 0.9961 0.9961 0.9961 1
 style {{ _inputAlert.GetStyleClass() }}
 {
  TextWidgetClass alertTitle {
   position 0.04 0.12
   hexactpos 0
   vexactpos 0
   size 0.92 0.25
   hexactsize 0
   vexactsize 0
   font "gui/fonts/etelkatextpro12"
   ignorepointer 1
   "exact text" 1
   style Bold
   "text color" 0.8314 0.6431 0.298 1
   text "ALERT TITLE"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ _inputAlert.title }}"
    }
   }
  }
  TextWidgetClass alertBody {
   position 0.04 0.4
   hexactpos 0
   vexactpos 0
   size 0.92 0.5
   hexactsize 0
   vexactsize 0
   "text color" 0.6039 0.5804 0.5333 1
   font "gui/fonts/etelkatextpro12"
   ignorepointer 1
   "exact text" 1
   wrap 1
   text "Alert message body text goes here."
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ _inputAlert.body }}"
    }
   }
  }
  ButtonWidgetClass alertActionBtn {
   position 0.7 0.82
   hexactpos 0
   vexactpos 0
   size 0.26 0.14
   hexactsize 0
   vexactsize 0
   color 0.9961 0.9961 0.9961 1
   "text color" 0.8314 0.6431 0.298 1
   font "gui/fonts/etelkatextpro12"
   "exact text" 1
   style Bold
   style TXTab
   text "ACTION"
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnAlertActionClicked"
    }
   }
  }
 }
}