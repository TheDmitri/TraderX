PanelWidgetClass vehicleRowRoot {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 84
 hexactsize 0
 vexactsize 1
 style TXCard
 color 0.9961 0.9961 0.9961 1
 {
  ButtonWidgetClass rowClickBtn {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   "text color" 0.9961 0.9961 0.9961 1
   style TXListRow
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnVehicleSelected"
    }
   }
  }
  PanelWidgetClass rowSelectedBg {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXCardSelected
   color 0.9961 0.9961 0.9961 1
  }
  PanelWidgetClass rowHealthBar {
   position 24 0
   hexactpos 1
   vexactpos 0
   size 10 10
   hexactsize 1
   vexactsize 1
   valign center_ref
   color 0.498 0.651 0.3529 1
   ignorepointer 1
   style rover_sim_colorable
  }
  TextWidgetClass rowName {
   position 52 14
   hexactpos 1
   vexactpos 1
   size 0.6 28
   hexactsize 0
   vexactsize 1
   color 0.949 0.9137 0.8471 1
   font "TraderX/datasets/fonts/rajdhanibpx20"
   ignorepointer 1
   "exact text" 1
   "text valign" center
   text "Vehicle"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ rowName }}"
    }
   }
  }
  TextWidgetClass rowHealth {
   position 52 44
   hexactpos 1
   vexactpos 1
   size 0.6 24
   hexactsize 0
   vexactsize 1
   color 0.6392 0.5725 0.4627 1
   font "TraderX/datasets/fonts/rajdhanibpx17"
   ignorepointer 1
   "exact text" 1
   "text valign" center
   text "Pristine - Fuel 100%"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ rowHealth }}"
    }
   }
  }
  TextWidgetClass rowBadge {
   position 24 0
   hexactpos 1
   vexactpos 0
   size 0.33333 84
   hexactsize 0
   vexactsize 1
   halign right_ref
   color 0.9098 0.5373 0.2902 1
   font "TraderX/datasets/fonts/monopx14"
   ignorepointer 1
   "exact text" 1
   "text halign" right
   "text valign" center
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ rowBadgeText }}"
    }
   }
  }
 }
}