PanelWidgetClass shareRowRoot {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 style TXCard
 color 0.9961 0.9961 0.9961 1
 {
  TextWidgetClass sharePlayerName {
   position 0.03 0
   hexactpos 0
   vexactpos 0
   size 0.5 1
   hexactsize 0
   vexactsize 0
   color 0.8471 0.8235 0.7529 1
   font "TraderX/datasets/fonts/oswalt14"
   ignorepointer 1
   "exact text" 1
   "text valign" center
   style Bold
   text "Survivor"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ playerNameText }}"
    }
   }
  }
  TextWidgetClass shareAccess {
   position 0.46 0
   hexactpos 0
   vexactpos 0
   size 0.28 1
   hexactsize 0
   vexactsize 0
   color 0.4157 0.3961 0.3765 1
   font "TraderX/datasets/fonts/jet-brains-mono11"
   ignorepointer 1
   "exact text" 1
   "text valign" center
   text "NEARBY"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ accessText }}"
    }
   }
  }
  ButtonWidgetClass shareAddBtn {
   position 0.78 0.15
   hexactpos 0
   vexactpos 0
   size 0.2 0.7
   hexactsize 0
   vexactsize 0
   "text color" 0.6039 0.6902 0.3529 1
   font "TraderX/datasets/fonts/oswalt12"
   "exact text" 1
   "text halign" center
   "text valign" center
   style Bold
   style TXBtnPrimary
   color 0.9961 0.9961 0.9961 1
   text "ADD"
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnToggle"
    }
   }
  }
  ButtonWidgetClass shareRemoveBtn {
   position 0.78 0.15
   hexactpos 0
   vexactpos 0
   size 0.2 0.7
   hexactsize 0
   vexactsize 0
   "text color" 0.7843 0.4 0.2902 1
   font "TraderX/datasets/fonts/oswalt12"
   "exact text" 1
   "text halign" center
   "text valign" center
   style Bold
   style TXBtnDefault
   color 0.9961 0.9961 0.9961 1
   text "REMOVE"
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnToggle"
    }
   }
  }
  ButtonWidgetClass shareConfirmBtn {
   position 0.78 0.15
   hexactpos 0
   vexactpos 0
   size 0.2 0.7
   hexactsize 0
   vexactsize 0
   "text color" 1 1 1 1
   font "TraderX/datasets/fonts/oswalt12"
   "exact text" 1
   "text halign" center
   "text valign" center
   style Bold
   style TXBtnDanger
   color 0.9961 0.9961 0.9961 1
