         vexactpos 0
         size 1 1
         hexactsize 0
         vexactsize 0
         halign center_ref
         valign center_ref
         color 0.9412 0.3961 0.2902 1
         ignorepointer 1
         image0 "set:traderxcarlock_icons image:close"
         mode blend
         "src alpha" 1
         "stretch mode" stretch_w_h
        }
       }
       {
        ScriptParamsClass {
         OnClick "OnCloseClick"
        }
       }
      }
     }
