PanelWidgetClass cardRoot {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 ignorepointer 1
 priority 999
 {
  GridSpacerWidgetClass cardSlot {
   position 0.75 0.09
   hexactpos 0
   vexactpos 0
   size 0.23 0.14
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   "Size To Content V" 1
   Columns 1
   Margin 12
   Padding 0
   style TXToastCard
   color 0.9961 0.9961 0.9961 1
   {
    GridSpacerWidgetClass GridContent {
     size 1 48
     hexactsize 0
     vexactsize 1
     ignorepointer 1
     "Size To Content V" 1
     Columns 1
     Margin 4
     Padding 6
     {
      PanelWidgetClass headerRow {
       size 1 34
       hexactsize 0
       vexactsize 1
       ignorepointer 1
       {
        PanelWidgetClass iconWell {
         position 0 0
         hexactpos 1
         vexactpos 1
         size 34 34
         hexactsize 1
         vexactsize 1
         ignorepointer 1
         style TXInset
         color 0.9961 0.9961 0.9961 1
         {
          ImageWidgetClass iconImg {
           position 0.12 0.12
           hexactpos 0
           vexactpos 0
           size 0.76 0.76
           hexactsize 0
           vexactsize 0
           color 0.851 0.4627 0.1843 1
           ignorepointer 1
           image0 "set:traderx_icons image:sale"
          }
         }
        }
        RichTextWidgetClass kickerText {
         position 0.16602 0
         hexactpos 0
         vexactpos 0
         size 0.8 1
         hexactsize 0
         vexactsize 0
         color 0.6392 0.5725 0.4627 1
         font "TraderX/datasets/fonts/rajdhanibpx14"
         ignorepointer 1
         "exact text" 1
         "text valign" center
         text "TRADER - SOLD"
         scriptclass "TextBinding"
         {
          ScriptParamsClass {
           Binding_Expression "{{ _notif.GetKicker() }}"
          }
         }
        }
       }
      }
      RichTextWidgetClass titleText {
       size 1 24
       hexactsize 0
       vexactsize 1
       color 0.949 0.9137 0.8471 1
       font "TraderX/datasets/fonts/rajdhanibpx20"
       ignorepointer 1
       "exact text" 1
       wrap 1
       "strip newlines" 1
       "size to text v" 1
       text "Item Sold"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ _notif.title }}"
        }
       }
      }
      RichTextWidgetClass bodyText {
       size 1 20
       hexactsize 0
       vexactsize 1
       color 0.7608 0.7098 0.6118 1
       font "TraderX/datasets/fonts/rajdhanipx17"
       ignorepointer 1
       "exact text" 1
       wrap 1
       "strip newlines" 1
       "size to text v" 1
       text "Successfully sold Ammo Box for 800."
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ _notif.body }}"
        }
       }
      }
      RichTextWidgetClass detailsText {
       size 1 18
       hexactsize 0
       vexactsize 1
       color 0.7608 0.7098 0.6118 1
       font "TraderX/datasets/fonts/rajdhanipx16"
       ignorepointer 1
       "exact text" 1
       wrap 1
       "size to text v" 1
       visible 0
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ _notif.GetDetailsText() }}"
        }
       }
      }
      RichTextWidgetClass footerText {
       size 1 16
       hexactsize 0
       vexactsize 1
       color 0.6392 0.5725 0.4627 1
       font "TraderX/datasets/fonts/rajdhanipx16"
       ignorepointer 1
       "exact text" 1
       "text valign" center
       visible 0
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ _notif.footer }}"
        }
       }
      }
     }
    }
    PanelWidgetClass progressRow {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 3
     hexactsize 0
     vexactsize 1
     ignorepointer 1
     {
      PanelWidgetClass progressTrack {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 1 1
       hexactsize 0
       vexactsize 0
       color 0.851 0.4627 0.1843 0.1412
       ignorepointer 1
       style rover_sim_colorable
      }
      PanelWidgetClass progressFill {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 1 1
       hexactsize 0
       vexactsize 0
       color 0.851 0.4627 0.1843 1
       ignorepointer 1
       style rover_sim_colorable
      }
     }
    }
   }
  }
  PanelWidgetClass leftRule {
   position 0.75 0.09
   hexactpos 0
   vexactpos 0
   size 0 0.14
   hexactsize 0
   vexactsize 0
   color 0.851 0.4627 0.1843 1
   ignorepointer 1
   style rover_sim_colorable
  }
  PanelWidgetClass queuePill {
   position 0.93 0.17
   hexactpos 0
   vexactpos 0
   size 0.06 0.02
   hexactsize 0
   vexactsize 0
   color 0.1098 0.0941 0.0745 0.8784
   visible 0
   ignorepointer 1
   style rover_sim_colorable
   {
    PanelWidgetClass queuePillFill {
     position 0.01 0.06
     hexactpos 0
     vexactpos 0
     size 0.98 0.88
     hexactsize 0
     vexactsize 0
     color 0.0588 0.051 0.0392 0.8
     ignorepointer 1
     style rover_sim_colorable
     {
      RichTextWidgetClass queueText {
       position 0.03 0
       hexactpos 0
       vexactpos 0
       size 0.4 1
       hexactsize 0
       vexactsize 0
       color 0.851 0.4627 0.1843 1
       font "TraderX/datasets/fonts/monopx14"
       ignorepointer 1
       "exact text" 1
       "text valign" center
       "text halign" right
       text "+3"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ queue_count }}"
        }
       }
      }
      RichTextWidgetClass queueLabel {
       position 0.47 0
       hexactpos 0
       vexactpos 0
       size 0.5 1
       hexactsize 0
       vexactsize 0
       color 0.6392 0.5725 0.4627 1
       font "TraderX/datasets/fonts/rajdhanibpx14"
       ignorepointer 1
       "exact text" 1
       "text valign" center
       text "QUEUED"
      }
     }
    }
   }
  }
 }
}