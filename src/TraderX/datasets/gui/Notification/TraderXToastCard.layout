PanelWidgetClass cardRoot {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 ignorepointer 1
 priority 999
 {
  GridSpacerWidgetClass cardSlot {
   position 0.8 0.02
   hexactpos 0
   vexactpos 0
   size 0.19 0.14
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   "Size To Content V" 1
   Columns 1
   Padding 8
   Margin 0
   style TXToastCard
   color 0.9961 0.9961 0.9961 1
   {
    GridSpacerWidgetClass GridContent {
     size 1 48
     hexactsize 0
     vexactsize 1
     ignorepointer 1
     "Size To Content V" 1
     Columns 1
     Padding 4
     Margin 4
     {
      PanelWidgetClass headerRow {
       size 1 30
       hexactsize 0
       vexactsize 1
       ignorepointer 1
       {
        PanelWidgetClass iconWell {
         position 0 0
         hexactpos 1
         vexactpos 1
         size 30 30
         hexactsize 1
         vexactsize 1
         ignorepointer 1
         style TXSurface
         color 0.9961 0.9961 0.9961 1
         {
          ImageWidgetClass iconImg {
           position 0.2 0.2
           hexactpos 0
           vexactpos 0
           size 0.6 0.6
           hexactsize 0
           vexactsize 0
           color 0.7686 0.6392 0.3529 1
           ignorepointer 1
           image0 "set:traderx_icons image:sale"
          }
         }
        }
        RichTextWidgetClass kickerText {
         position 40 0
         hexactpos 1
         vexactpos 0
         size 0.8 1
         hexactsize 0
         vexactsize 0
         color 0.5412 0.5608 0.5882 1
         font "TraderX/datasets/fonts/oswalt12"
         ignorepointer 1
         "text valign" center
         text "TRADER - SOLD"
         scriptclass "TextBinding"
         {
          ScriptParamsClass {
           Binding_Expression "{{ _notif.GetKicker() }}"
          }
         }
        }
       }
      }
      RichTextWidgetClass titleText {
       size 1 20
       hexactsize 0
       vexactsize 1
       color 0.9255 0.9098 0.8549 1
       font "TraderX/datasets/fonts/oswalt16"
       ignorepointer 1
       wrap 1
       "strip newlines" 1
       "size to text v" 1
       text "Item Sold"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ _notif.title }}"
        }
       }
      }
      RichTextWidgetClass bodyText {
       size 1 18
       hexactsize 0
       vexactsize 1
       color 0.6588 0.6902 0.6549 1
       font "TraderX/datasets/fonts/oswalt14"
       ignorepointer 1
       wrap 1
       "strip newlines" 1
       "size to text v" 1
       text "Successfully sold Ammo Box for 800."
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ _notif.body }}"
        }
       }
      }
      RichTextWidgetClass detailsText {
       size 1 16
       hexactsize 0
       vexactsize 1
       color 0.6588 0.6902 0.6549 1
       font "TraderX/datasets/fonts/oswalt13"
       ignorepointer 1
       wrap 1
       "size to text v" 1
       visible 0
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ _notif.GetDetailsText() }}"
        }
       }
      }
      RichTextWidgetClass footerText {
       size 1 14
       hexactsize 0
       vexactsize 1
       color 0.6039 0.6275 0.6039 1
       font "TraderX/datasets/fonts/oswalt12"
       ignorepointer 1
       "text valign" center
       visible 0
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ _notif.footer }}"
        }
       }
      }
     }
    }
    PanelWidgetClass progressRow {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 3
     hexactsize 0
     vexactsize 1
     ignorepointer 1
     {
      PanelWidgetClass progressTrack {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 1 1
       hexactsize 0
       vexactsize 0
       color 0.7686 0.6392 0.3529 0.1412
       ignorepointer 1
       style rover_sim_colorable
      }
      PanelWidgetClass progressFill {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 1 1
       hexactsize 0
       vexactsize 0
       color 0.7686 0.6392 0.3529 1
       ignorepointer 1
       style rover_sim_colorable
      }
     }
    }
   }
  }
  PanelWidgetClass leftRule {
   position 0.8 0.02
   hexactpos 0
   vexactpos 0
   size 0 0.14
   hexactsize 0
   vexactsize 0
   color 0.7686 0.6392 0.3529 1
   ignorepointer 1
   style rover_sim_colorable
  }
  PanelWidgetClass queuePill {
   position 0.93 0.17
   hexactpos 0
   vexactpos 0
   size 0.06 0.02
   hexactsize 0
   vexactsize 0
   color 0.1176 0.1333 0.1529 0.8784
   visible 0
   ignorepointer 1
   style rover_sim_colorable
   {
    PanelWidgetClass queuePillFill {
     position 0.01 0.06
     hexactpos 0
     vexactpos 0
     size 0.98 0.88
     hexactsize 0
     vexactsize 0
     color 0.0588 0.0706 0.0824 0.8
     ignorepointer 1
     style rover_sim_colorable
     {
      RichTextWidgetClass queueText {
       position 0.03 0
       hexactpos 0
       vexactpos 0
       size 0.4 1
       hexactsize 0
       vexactsize 0
       color 0.7686 0.6392 0.3529 1
       font "TraderX/datasets/fonts/jet-brains-mono12"
       ignorepointer 1
       "text valign" center
       "text halign" right
       text "+3"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ queue_count }}"
        }
       }
      }
      RichTextWidgetClass queueLabel {
       position 0.47 0
       hexactpos 0
       vexactpos 0
       size 0.5 1
       hexactsize 0
       vexactsize 0
       color 0.5412 0.5608 0.5882 1
       font "TraderX/datasets/fonts/oswalt12"
       ignorepointer 1
       "text valign" center
       text "QUEUED"
      }
     }
    }
   }
  }
 }
}