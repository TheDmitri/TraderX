      }
     }
    }
    TextWidgetClass minNeeded {
     position 0.03 0.31
     hexactpos 0
     vexactpos 0
     size 0.94 0.04
     hexactsize 0
     vexactsize 0
     "text color" 0.6039 0.5804 0.5333 1
     font "TraderX/datasets/fonts/RobotoCondensedVF12"
     ignorepointer 1
     "exact text" 1
     "text valign" center
     text "#tpm_minimal_quantity 60"
