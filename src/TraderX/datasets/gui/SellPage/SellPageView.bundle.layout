     vexactsize 0
     "text color" 0.8471 0.8235 0.7529 1
     font "TraderX/datasets/fonts/RobotoCondensedVF14"
     ignorepointer 1
     "exact text" 1
     "text valign" center
     text "#tpm_maximal_quantity 5000"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
