      TextWidgetClass maxQtyLabel {
       position 0.5 0
       hexactpos 0
       vexactpos 0
       size 0.5 1
       hexactsize 0
       vexactsize 0
       "text color" 0.6039 0.5804 0.5333 1
       font "TraderX/datasets/fonts/RobotoCondensedVF12"
       ignorepointer 1
       "exact text" 1
       "text valign" center
       "text halign" right
