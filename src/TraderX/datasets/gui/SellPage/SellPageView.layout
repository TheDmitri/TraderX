PanelWidgetClass SellPageView {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 ignorepointer 1
 style TXContent
 color 0.9961 0.9961 0.9961 1
 {
  PanelWidgetClass topBar {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 0.06
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXSurface
   color 0.9961 0.9961 0.9961 1
   {
    PanelWidgetClass SearchBarHost {
     position 0.36 0.22
     hexactpos 0
     vexactpos 0
     size 0.26 0.56
     hexactsize 0
     vexactsize 0
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_Selector "tx-search-bar"
      }
     }
    }
    PanelWidgetClass ViewToggleHost {
     position 0.64 0.22
     hexactpos 0
     vexactpos 0
     size 0.08 0.56
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_Selector "tx-view-toggle"
      }
     }
    }
   }
  }
  PanelWidgetClass ContainerListPanel {
   position 0 0.07
   hexactpos 0
   vexactpos 0
   size 0.7 0.92
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXSurface
   color 0.9961 0.9961 0.9961 1
   {
    PanelWidgetClass PlayerSlotHost {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 0.07
     hexactsize 0
     vexactsize 0
     style TXSurface
     color 0.9961 0.9961 0.9961 1
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_Selector "tx-player-slot-nav"
      }
     }
    }
    TextWidgetClass containerTitle {
     position 0.01 0.09
     hexactpos 0
     vexactpos 0
     size 0.6 0.05
     hexactsize 0
     vexactsize 0
     "text color" 0.6039 0.5804 0.5333 1
     font "TraderX/datasets/fonts/oswalt14"
     ignorepointer 1
     "exact text" 1
     text "#tpm_select_container_to_sell"
    }
    ScrollWidgetClass scrollSell {
     position 0.01 0.07
     hexactpos 0
     vexactpos 0
     size 0.98 0.92
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     "Scrollbar V" 1
     {
      GridSpacerWidgetClass sellGridList {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 1 0.01
       hexactsize 0
       vexactsize 0
       "Size To Content V" 1
       Columns 1
       Rows 100
       Margin 6
       scriptclass "ComponentWidgetBinding"
       {
        ScriptParamsClass {
         Component_ForEach "{{ _inputSellProducts }}"
         Component_Template "tx-item-card-small"
         Component_ItemProperty "_inputProduct"
        }
       }
      }
      GridSpacerWidgetClass sellGridTiles {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 1 0.01
       hexactsize 0
       vexactsize 0
       "Size To Content V" 1
       Columns 3
       Rows 100
       Margin 6
       scriptclass "ComponentWidgetBinding"
       {
        ScriptParamsClass {
         Component_ForEach "{{ _inputSellProducts }}"
         Component_Template "tx-item-card-large"
         Component_ItemProperty "_inputProduct"
        }
       }
      }
     }
    }
   }
  }
