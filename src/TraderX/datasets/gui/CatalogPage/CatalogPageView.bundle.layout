PanelWidgetClass CatalogPageView {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 ignorepointer 1
 style TXContent
 color 0.9961 0.9961 0.9961 1
 {
  PanelWidgetClass topBar {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 0.06
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXSurface
   color 0.9961 0.9961 0.9961 1
   {
    PanelWidgetClass SearchBarHost {
     position 0.36 0.22
     hexactpos 0
     vexactpos 0
     size 0.22 0.56
     hexactsize 0
     vexactsize 0
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_Selector "tx-search-bar"
      }
     }
    }
    ButtonWidgetClass toggleExpandBtn {
     position 0.59 0.22
     hexactpos 0
     vexactpos 0
     size 0.06 0.56
     hexactsize 0
     vexactsize 0
     "text color" 0.9961 0.9961 0.9961 1
     "text color" 0.8471 0.8235 0.7529 1
     font "TraderX/datasets/fonts/RobotoCondensedVF12"
     "exact text" 1
     style "TXBtnDefault"
     style Bold
     color 0.9961 0.9961 0.9961 1
     text "#tpm_expand_all"
     scriptclass "ButtonBinding"
     {
      ScriptParamsClass {
       OnClick "OnToggleExpandClick"
      }
     }
    }
    PanelWidgetClass ViewToggleHost {
     position 0.66 0.22
     hexactpos 0
     vexactpos 0
     size 0.08 0.56
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_Selector "tx-view-toggle"
      }
     }
    }
   }
  }
  PanelWidgetClass CatalogListPanel {
   position 0 0.07
   hexactpos 0
   vexactpos 0
   size 0.69 0.92
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXSurface
   color 0.9961 0.9961 0.9961 1
   {
    TextWidgetClass catalogTitle {
     position 0.01 0.01
     hexactpos 0
     vexactpos 0
     size 0.4 0.04
     hexactsize 0
     vexactsize 0
     "text color" 0.6039 0.5804 0.5333 1
     font "TraderX/datasets/fonts/RobotoCondensedVF14"
     ignorepointer 1
     "exact text" 1
     text "#tpm_catalog_items"
    }
    ScrollWidgetClass scrollCategory {
     position 0.01 0.07
     hexactpos 0
     vexactpos 0
     size 0.98 0.92
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     "Scrollbar V" 1
     {
      GridSpacerWidgetClass categoryGrid {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 1 0.01
       hexactsize 0
       vexactsize 0
       "Size To Content V" 1
       Columns 1
       Rows 100
       Margin 6
       scriptclass "ComponentWidgetBinding"
       {
        ScriptParamsClass {
         Component_ForEach "{{ _inputCategories }}"
         Component_Template "tx-catalog-category-card"
         Component_ItemProperty "_inputCategory"
        }
       }
      }
     }
    }
   }
  }
  PanelWidgetClass ItemDetailsPanel {
   position 0.7 0.07
   hexactpos 0
   vexactpos 0
   size 0.29 0.92
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXCard
   color 0.9961 0.9961 0.9961 1
   {
    TextWidgetClass detailsTitle {
     position 0 0.02
     hexactpos 0
     vexactpos 0
     size 1 0.04
     hexactsize 0
     vexactsize 0
     "text color" 0.8471 0.8235 0.7529 1
     font "TraderX/datasets/fonts/RobotoCondensedVF16"
     ignorepointer 1
     style Bold
     "exact text" 1
     "text halign" center
     text "#tpm_item_details"
    }
    ItemPreviewWidgetClass itemPreview {
     position 0.06 0.08
     hexactpos 0
     vexactpos 0
     size 0.88 0.34
     hexactsize 0
     vexactsize 0
     scriptclass "ItemPreviewBinding"
     {
      ScriptParamsClass {
       Binding_Item "{{ selected_preview }}"
       Enable_Rotation 1
       Enable_Scale 1
      }
     }
    }
    TextWidgetClass itemName {
     position 0 0.44
     hexactpos 0
     vexactpos 0
     size 1 0.05
     hexactsize 0
     vexactsize 0
     "text color" 0.8471 0.8235 0.7529 1
     font "TraderX/datasets/fonts/RobotoCondensedVF16"
     ignorepointer 1
     style Bold
     "exact text" 1
     "text halign" center
     text "Item Name"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ selected_item_name }}"
      }
     }
    }
    PanelWidgetClass sellBox {
     position 0.06 0.51
     hexactpos 0
     vexactpos 0
     size 0.42 0.1
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     style TXSurface
     color 0.9961 0.9961 0.9961 1
     {
      TextWidgetClass sellLabel {
       position 0 0.12
       hexactpos 0
       vexactpos 0
       size 1 0.35
       hexactsize 0
       vexactsize 0
       "text color" 0.6039 0.5804 0.5333 1
       font "TraderX/datasets/fonts/RobotoCondensedVF12"
       ignorepointer 1
       "exact text" 1
       "text halign" center
       text "#tpm_sell_price"
      }
      TextWidgetClass sellPrice {
       position 0 0.5
       hexactpos 0
       vexactpos 0
       size 1 0.45
       hexactsize 0
       vexactsize 0
       "text color" 0.4196 0.5569 0.3529 1
       font "TraderX/datasets/fonts/RobotoCondensedVF16"
       ignorepointer 1
       style Bold
       "exact text" 1
       "text halign" center
       text "0"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ selected_sell_price }}"
        }
       }
      }
     }
    }
    PanelWidgetClass buyBox {
     position 0.52 0.51
     hexactpos 0
     vexactpos 0
     size 0.42 0.1
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     style TXSurface
     color 0.9961 0.9961 0.9961 1
     {
      TextWidgetClass buyLabel {
       position 0 0.12
       hexactpos 0
       vexactpos 0
       size 1 0.35
       hexactsize 0
       vexactsize 0
       "text color" 0.6039 0.5804 0.5333 1
       font "TraderX/datasets/fonts/RobotoCondensedVF12"
       ignorepointer 1
       "exact text" 1
       "text halign" center
       text "#tpm_buy_price"
      }
      TextWidgetClass buyPrice {
       position 0 0.5
       hexactpos 0
       vexactpos 0
       size 1 0.45
       hexactsize 0
       vexactsize 0
       "text color" 0.7686 0.6392 0.3529 1
       font "TraderX/datasets/fonts/RobotoCondensedVF16"
       ignorepointer 1
       style Bold
       "exact text" 1
       "text halign" center
       text "0"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ selected_buy_price }}"
        }
       }
      }
     }
    }
    TextWidgetClass stockText {
     position 0 0.63
     hexactpos 0
     vexactpos 0
     size 1 0.04
     hexactsize 0
     vexactsize 0
     "text color" 0.6039 0.5804 0.5333 1
     font "TraderX/datasets/fonts/RobotoCondensedVF14"
     ignorepointer 1
     "exact text" 1
     "text halign" center
     text "#tpm_stock 0/10"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ selected_stock }}"
      }
     }
    }
    PanelWidgetClass descBox {
     position 0.06 0.69
     hexactpos 0
     vexactpos 0
     size 0.88 0.28
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     style TXSurface
     color 0.9961 0.9961 0.9961 1
     {
      TextWidgetClass descText {
       position 0.06 0.08
       hexactpos 0
       vexactpos 0
       size 0.88 0.84
       hexactsize 0
       vexactsize 0
       "text color" 0.6039 0.5804 0.5333 1
       font "TraderX/datasets/fonts/RobotoCondensedVF12"
       ignorepointer 1
       wrap 1
       text "Select an item to view details"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ selected_description }}"
        }
       }
      }
     }
    }
   }
  }
 }
}