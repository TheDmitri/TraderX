  ScrollWidgetClass scrollCategory {
   position 29 96
   hexactpos 1
   vexactpos 1
   size 0.73229 830
   hexactsize 0
   vexactsize 1
   "Scrollbar V" 1
   {
    GridSpacerWidgetClass categoryGrid {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 0.01
     hexactsize 0
     vexactsize 0
     "Size To Content V" 1
     Columns 1
     Rows 100
     Padding 10
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_ForEach "{{ _inputCategories }}"
       Component_Template "tx-catalog-category-card"
       Component_ItemProperty "_inputCategory"
      }
     }
    }
   }
  }
