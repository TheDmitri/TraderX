PanelWidgetClass CatalogPageView {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 color 0.0745 0.0627 0.0471 1
 ignorepointer 1
 style rover_sim_colorable
 {
  WrapSpacerWidgetClass catalogTitleRow {
   position 29 24
   hexactpos 1
   vexactpos 1
   size 0.3125 60
   hexactsize 0
   vexactsize 1
   ignorepointer 1
   Padding 19
   {
    TextWidgetClass catalogHeading {
     size 1 57
     hexactsize 1
     vexactsize 1
     color 0.949 0.9137 0.8471 1
     font "TraderX/datasets/fonts/antonpx41"
     ignorepointer 1
     "exact text" 1
     "text valign" bottom
     "size to text h" 1
     text "#tpm_catalog_caps"
    }
    TextWidgetClass catalogTitle {
     size 1 54
     hexactsize 1
     vexactsize 1
     color 0.6392 0.5725 0.4627 1
     font "TraderX/datasets/fonts/rajdhanibpx18"
     ignorepointer 1
     "exact text" 1
     "text valign" bottom
     "size to text h" 1
     text "#tpm_catalog_items"
    }
   }
  }
  PanelWidgetClass SearchBarHost {
   position 0.3125 26
   hexactpos 0
   vexactpos 1
   size 0.1875 45
   hexactsize 0
   vexactsize 1
   halign right_ref
   scriptclass "ComponentWidgetBinding"
   {
    ScriptParamsClass {
     Component_Selector "tx-search-bar"
    }
   }
  }
  PanelWidgetClass toggleExpandHost {
   position 0.51042 27
   hexactpos 0
   vexactpos 1
   size 0.07812 43
   hexactsize 0
   vexactsize 1
   halign right_ref
   ignorepointer 1
   {
    ButtonWidgetClass toggleExpandBtn {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 1
     hexactsize 0
     vexactsize 0
     "text color" 0.9961 0.9961 0.9961 1
     visible 0
     style TXBtnDefault
     color 0.9961 0.9961 0.9961 1
     scriptclass "ButtonBinding"
     {
      TextWidgetClass toggleExpandText {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 1 1
       hexactsize 0
       vexactsize 0
       color 0.7608 0.7098 0.6118 1
       font "TraderX/datasets/fonts/rajdhanibpx17"
       ignorepointer 1
       "exact text" 1
       "text halign" center
       "text valign" center
       text "#tpm_expand_all"
      }
     }
     {
      ScriptParamsClass {
       OnClick "OnToggleExpandClick"
      }
     }
    }
   }
  }
  PanelWidgetClass syncIndicator {
   position 0.51042 27
   hexactpos 0
   vexactpos 1
   size 0.07812 43
   hexactsize 0
   vexactsize 1
   halign right_ref
   ignorepointer 1
   {
    ImageWidgetClass syncIcon {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 18 18
     hexactsize 1
     vexactsize 1
     valign center_ref
     color 0.851 0.4627 0.1843 1
     ignorepointer 1
     image0 "set:traderx_icons image:refresh"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
    TextWidgetClass syncText {
     position 28 0
     hexactpos 1
     vexactpos 0
