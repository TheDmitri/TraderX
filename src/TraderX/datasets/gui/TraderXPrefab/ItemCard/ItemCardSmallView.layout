PanelWidgetClass itemCardView {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 72
 hexactsize 0
 vexactsize 1
 ignorepointer 1
 {
  ButtonWidgetClass itemCardMainBtn {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   "text color" 0.9961 0.9961 0.9961 1
   style TXListRow
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnItemCardLeftClick"
     OnRightClick "OnItemCardRightClick"
     OnDoubleClick "OnItemCardDoubleClick"
     OnMouseEnter "OnItemCardMouseEnter"
     OnMouseLeave "OnItemCardMouseLeave"
    }
   }
  }
  PanelWidgetClass itemCardOutline {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXListRowSelected
   color 0.9961 0.9961 0.9961 1
  }
  PanelWidgetClass itemCardContent {
   position 0 0.03
   hexactpos 0
   vexactpos 0
   size 0.99 0.94
   hexactsize 0
   vexactsize 0
   color 0 0 0 0
   ignorepointer 1
   style rover_sim_colorable
   {
    ButtonWidgetClass volumeBtn {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 5 0.86
     hexactsize 1
     vexactsize 0
     valign center_ref
     "text color" 0.9961 0.9961 0.9961 1
     style TXProgressBg
     color 0.9961 0.9961 0.9961 1
     {
      ProgressBarWidgetClass volumeBar {
       position 0 0.4
       hexactpos 0
       vexactpos 0
       size 1 0.6
       hexactsize 0
       vexactsize 0
       ignorepointer 1
       style TXProgressFill
       color 0.9961 0.9961 0.9961 1
      }
     }
    }
    PanelWidgetClass previewBg {
     position 0.01 0.06
     hexactpos 0
     vexactpos 0
     size 84 56
     hexactsize 1
     vexactsize 1
     color 0.0235 0.0275 0.0392 1
     ignorepointer 1
     style rover_sim_colorable
    }
    ItemPreviewWidgetClass itemPreview {
     position 0.01 0.06
     hexactpos 0
     vexactpos 0
     size 84 56
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     scriptclass "ItemPreviewBinding"
     {
      ScriptParamsClass {
       Binding_Item "{{ preview }}"
      }
     }
    }
    ImageWidgetClass healthImg {
     position 0.01 0.06
     hexactpos 0
     vexactpos 0
     size 10 10
     hexactsize 1
     vexactsize 1
     color 0.4196 0.5569 0.3529 1
     ignorepointer 1
     image0 "set:traderx_icons image:circle"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
    TextWidgetClass classNameText {
     position 0.13 0.1
     hexactpos 0
     vexactpos 0
     size 0.4 0.44
     hexactsize 0
     vexactsize 0
     color 0.8471 0.8235 0.7529 1
     font "TraderX/datasets/fonts/oswalt14"
     ignorepointer 1
     style Bold
     "exact text" 1
     "text valign" center
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ itemName }}"
      }
     }
    }
    TextWidgetClass quantityStr {
     position 0.13 0.56
     hexactpos 0
     vexactpos 0
     size 0.4 0.36
     hexactsize 0
     vexactsize 0
     color 0.4157 0.3961 0.3765 1
     font "TraderX/datasets/fonts/jet-brains-mono12"
     ignorepointer 1
     "exact text" 1
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ quantityStr }}"
      }
     }
    }
    GridSpacerWidgetClass stockGrid {
     position 0.48 0
     hexactpos 0
     vexactpos 0
     size 0.22 32
     hexactsize 0
     vexactsize 1
     ignorepointer 1
     Columns 2
     Rows 1
     Margin 5
     Padding 3
     "Size To Content H" 1
     "Size To Content V" 1
     valign center_ref
     {
      ImageWidgetClass stockIcon {
       size 32 32
       hexactsize 1
       vexactsize 1
       color 0.6039 0.5804 0.5333 1
       ignorepointer 1
       image0 "set:traderx_icons image:stockSimple"
       mode blend
       "src alpha" 1
       "stretch mode" stretch_w_h
      }
      TextWidgetClass stockText {
       color 0.6039 0.5804 0.5333 1
       font "TraderX/datasets/fonts/jet-brains-mono16"
       ignorepointer 1
       style Bold
       "exact text" 1
       "text valign" center
       "size to text h" 1
       text "0/15"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ itemStock }}"
        }
       }
      }
     }
    }
    GridSpacerWidgetClass priceGrid {
     position 0.58 0
     hexactpos 0
     vexactpos 0
     size 0.37 32
     hexactsize 0
     vexactsize 1
     ignorepointer 1
     Columns 4
     Rows 1
     Margin 5
     Padding 3
     "Size To Content H" 1
     "Size To Content V" 1
     valign center_ref
     {
      ImageWidgetClass priceIcon {
       size 32 32
       hexactsize 1
       vexactsize 1
       color 0.7686 0.6392 0.3529 1
       ignorepointer 1
       image0 "set:traderx_icons image:simpleCoins"
       mode blend
       "src alpha" 1
       "stretch mode" stretch_w_h
      }
      TextWidgetClass priceText {
       color 0.7686 0.6392 0.3529 1
       font "TraderX/datasets/fonts/jet-brains-mono16"
       ignorepointer 1
       style Bold
       "exact text" 1
       "text valign" center
       "size to text h" 1
       text "1,250"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ itemPrice }}"
        }
       }
      }
      PanelWidgetClass priceSpacer {
       size 20 1
       hexactsize 1
       vexactsize 1
       ignorepointer 1
      }
      TextWidgetClass sellPriceText {
       color 0.7843 0.4 0.2902 1
       color 0.6902 0.6902 0.6902 1
       font "TraderX/datasets/fonts/jet-brains-mono12"
       ignorepointer 1
       "exact text" 1
       "text valign" center
       "size to text h" 1
       text "sell 500"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ itemSellPrice }}"
        }
       }
      }
     }
    }
   }
  }
  ButtonWidgetClass favBtn {
   position 0.92 0
   hexactpos 0
   vexactpos 0
   size 26 26
   hexactsize 1
   vexactsize 1
   valign center_ref
   "text color" 0.9961 0.9961 0.9961 1
   style Empty
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ImageWidgetClass favIcon {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 1
     hexactsize 0
     vexactsize 0
     color 0.7686 0.6392 0.3529 1
     ignorepointer 1
     image0 "set:traderx_icons image:star_full"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
    ImageWidgetClass unfavIcon {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 1
     hexactsize 0
     vexactsize 0
     color 0.6039 0.5804 0.5333 1
     ignorepointer 1
     visible 0
     image0 "set:traderx_icons image:star"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
   }
   {
    ScriptParamsClass {
     OnClick "OnItemFavClick"
    }
   }
  }
 }
}