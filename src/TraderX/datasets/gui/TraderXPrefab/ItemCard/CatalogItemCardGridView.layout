PanelWidgetClass itemCardView {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 236
 hexactsize 0
 vexactsize 1
 ignorepointer 1
 {
  PanelWidgetClass itemCardBase {
   position 0 0
