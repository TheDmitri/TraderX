PanelWidgetClass itemCardView {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 300
 hexactsize 0
 vexactsize 1
 ignorepointer 1
 {
  PanelWidgetClass itemCardOutline {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXCardElevated
   color 0.9961 0.9961 0.9961 1
  }
  ButtonWidgetClass itemCardMainBtn {
   position 0.01 0.01
   hexactpos 0
   vexactpos 0
   size 0.98 0.98
   hexactsize 0
   vexactsize 0
   "text color" 0.9961 0.9961 0.9961 1
   style Empty
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnCatalogItemClick"
     OnDoubleClick "OnCatalogItemDoubleClick"
    }
   }
  }
  PanelWidgetClass itemCardContent {
   position 0.01 0.01
   hexactpos 0
   vexactpos 0
   size 0.98 0.98
   hexactsize 0
   vexactsize 0
   color 0 0 0 0
   ignorepointer 1
   style rover_sim_colorable
   {
    PanelWidgetClass previewWell {
     position 0.04 0.03
     hexactpos 0
     vexactpos 0
     size 0.92 0.54
     hexactsize 0
     vexactsize 0
     color 0.0235 0.0275 0.0392 1
     ignorepointer 1
     style rover_sim_colorable
    }
    ItemPreviewWidgetClass itemPreview {
     position 0.04 0.05
     hexactpos 0
     vexactpos 0
     size 0.92 0.5
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     clipchildren 1
     priority 1
     scriptclass "ItemPreviewBinding"
     {
      ScriptParamsClass {
       Binding_Item "{{ preview }}"
      }
     }
    }
    ImageWidgetClass healthImg {
     position 0.08 0.05
     hexactpos 0
     vexactpos 0
     size 12 12
     hexactsize 1
     vexactsize 1
     color 0.4196 0.5569 0.3529 1
     ignorepointer 1
     visible 0
     image0 "set:traderx_icons image:circle"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
    TextWidgetClass stockText {
     position 0.4 0.05
     hexactpos 0
     vexactpos 0
     size 0.52 0.08
     hexactsize 0
     vexactsize 0
     color 0.6039 0.5804 0.5333 1
     font "TraderX/datasets/fonts/jet-brains-mono12"
     ignorepointer 1
     "exact text" 1
     "text halign" right
     text "0/15"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ itemStock }}"
      }
     }
    }
    PanelWidgetClass infoStrip {
     position 0 0.58
     hexactpos 0
     vexactpos 0
     size 1 0.42
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     style TXSurface
     color 0.9961 0.9961 0.9961 1
     {
      TextWidgetClass itemName {
       position 0.06 0.06
       hexactpos 0
       vexactpos 0
       size 0.88 0.3
       hexactsize 0
       vexactsize 0
       color 0.8471 0.8235 0.7529 1
       font "TraderX/datasets/fonts/oswalt16"
       ignorepointer 1
       style Bold
       "exact text" 1
       "text halign" center
       text "Item Name"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ itemName }}"
        }
       }
      }
      GridSpacerWidgetClass priceGrid {
       position 0.28 0.46
       hexactpos 0
       vexactpos 0
       size 0.4 0.32
       hexactsize 0
       vexactsize 0
       ignorepointer 1
       Columns 2
       Rows 1
       Margin 6
       "Size To Content H" 1
       {
        ImageWidgetClass priceIcon {
         size 32 32
         hexactsize 1
         vexactsize 1
         color 0.7686 0.6392 0.3529 1
         ignorepointer 1
         image0 "set:traderx_icons image:simpleCoins"
         mode blend
         "src alpha" 1
         "stretch mode" stretch_w_h
        }
        TextWidgetClass itemPrice {
         color 0.7686 0.6392 0.3529 1
         font "TraderX/datasets/fonts/jet-brains-mono22"
         ignorepointer 1
         style Bold
         "exact text" 1
         "text valign" center
         "size to text h" 1
         text "1,250"
         scriptclass "TextBinding"
         {
          ScriptParamsClass {
           Binding_Expression "{{ itemPrice }}"
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
}