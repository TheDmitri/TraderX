   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   color 0.1098 0.0941 0.0745 1
   ignorepointer 1
   style rover_sim_colorable
  }
  PanelWidgetClass previewWell {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 158
   hexactsize 0
   vexactsize 1
   color 0.0588 0.051 0.0392 1
   ignorepointer 1
   style rover_sim_colorable
  }
  ButtonWidgetClass itemCardMainBtn {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   "text color" 0.9961 0.9961 0.9961 1
   style Empty
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnCatalogItemClick"
     OnDoubleClick "OnCatalogItemDoubleClick"
    }
   }
  }
  PanelWidgetClass itemCardContent {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   color 0 0 0 0
   ignorepointer 1
   style rover_sim_colorable
   {
    ItemPreviewWidgetClass itemPreview {
     position 0 14
     hexactpos 0
     vexactpos 1
     size 0.8 130
     hexactsize 0
     vexactsize 1
     halign center_ref
     ignorepointer 1
     clipchildren 1
     scriptclass "ItemPreviewBinding"
     {
      ScriptParamsClass {
       Binding_Item "{{ preview }}"
      }
     }
    }
    ImageWidgetClass healthImg {
     position 12 136
     hexactpos 1
     vexactpos 1
     size 10 10
     hexactsize 1
     vexactsize 1
     halign right_ref
     color 0.498 0.651 0.3529 1
     ignorepointer 1
     visible 0
     image0 "set:traderx_icons image:circle"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
    TextWidgetClass stockText {
     position 12 132
     hexactpos 1
     vexactpos 1
     size 0.5597 18
     hexactsize 0
     vexactsize 1
     color 0.6392 0.5725 0.4627 1
     font "TraderX/datasets/fonts/monopx14"
     ignorepointer 1
     "exact text" 1
     "text valign" center
     text "0/15"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ itemStock }}"
      }
     }
    }
    TextWidgetClass itemName {
     position 14 170
     hexactpos 1
     vexactpos 1
     size 0.88 24
     hexactsize 0
     vexactsize 1
     color 0.949 0.9137 0.8471 1
     font "TraderX/datasets/fonts/rajdhanibpx20"
     ignorepointer 1
     "exact text" 1
     "text valign" center
     text "Item Name"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ itemName }}"
      }
     }
    }
    TextWidgetClass itemPrice {
     position 14 200
     hexactpos 1
     vexactpos 1
     size 0.88 26
     hexactsize 0
     vexactsize 1
     color 0.9098 0.5373 0.2902 1
     font "TraderX/datasets/fonts/monopx22"
     ignorepointer 1
     "exact text" 1
     "text valign" center
     text "€ 1,250"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ itemPrice }}"
      }
     }
    }
   }
  }
