PanelWidgetClass CatalogItemCardView {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 92
 hexactsize 0
 vexactsize 1
 ignorepointer 1
 {
  PanelWidgetClass itemCardOutline {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXCardElevated
   color 0.9961 0.9961 0.9961 1
  }
  ButtonWidgetClass itemCardBtn {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   "text color" 0.9961 0.9961 0.9961 1
   style Empty
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnCatalogItemClick"
     OnDoubleClick "OnCatalogItemDoubleClick"
    }
   }
  }
  PanelWidgetClass previewBg {
   position 0.02 0.12
   hexactpos 0
   vexactpos 0
   size 0.13 0.76
   hexactsize 0
   vexactsize 0
   color 0.0706 0.0784 0.102 1
   ignorepointer 1
   style rover_sim_colorable
  }
  ItemPreviewWidgetClass itemPreview {
   position 0.02 0.12
   hexactpos 0
   vexactpos 0
   size 0.13 0.76
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   clipchildren 1
   scriptclass "ItemPreviewBinding"
   {
    ScriptParamsClass {
     Binding_Item "{{ preview }}"
    }
   }
  }
  TextWidgetClass itemName {
   position 0.17 0.14
   hexactpos 0
   vexactpos 0
   size 0.48 0.4
   hexactsize 0
   vexactsize 0
   "text color" 0.8471 0.8235 0.7529 1
   font "TraderX/datasets/fonts/oswalt16"
   ignorepointer 1
   style Bold
   "exact text" 1
   "text valign" center
   text "Item Name"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ itemName }}"
    }
   }
  }
  TextWidgetClass itemStock {
   position 0.17 0.56
   hexactpos 0
   vexactpos 0
   size 0.48 0.32
   hexactsize 0
   vexactsize 0
   "text color" 0.6039 0.5804 0.5333 1
   font "TraderX/datasets/fonts/oswalt12"
   ignorepointer 1
   "exact text" 1
   "text valign" center
   text "Stock: 12"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ itemStock }}"
    }
   }
  }
  GridSpacerWidgetClass priceGrid {
   position 0.66 0
   hexactpos 0
   vexactpos 0
   size 0.3 1
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   Columns 2
   Rows 1
   Margin 6
   "Size To Content H" 1
   "Size To Content V" 1
   valign center_ref
   {
    ImageWidgetClass priceIcon {
     size 28 28
     hexactsize 1
     vexactsize 1
     color 0.7686 0.6392 0.3529 1
     ignorepointer 1
     image0 "set:traderx_icons image:simpleCoins"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
    TextWidgetClass itemPrice {
     color 0.7686 0.6392 0.3529 1
     font "TraderX/datasets/fonts/jet-brains-mono22"
     ignorepointer 1
     style Bold
     "exact text" 1
     "text valign" center
     "size to text h" 1
     text "1,250"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ itemPrice }}"
      }
     }
    }
   }
  }
 }
}