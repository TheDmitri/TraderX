   {
    ScriptParamsClass {
     Binding_Expression "{{ itemStock }}"
    }
   }
  }
  TextWidgetClass itemPrice {
   position 0.1138 0
   hexactpos 0
   vexactpos 0
   size 0.15647 80
   hexactsize 0
   vexactsize 1
