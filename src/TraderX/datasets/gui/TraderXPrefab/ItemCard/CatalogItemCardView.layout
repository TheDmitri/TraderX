PanelWidgetClass CatalogItemCardView {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 80
 hexactsize 0
 vexactsize 1
 ignorepointer 1
 style TXRowRule
 color 0.9961 0.9961 0.9961 1
 {
  PanelWidgetClass itemCardOutline {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   visible 0
   style TXCardSelected
   color 0.9961 0.9961 0.9961 1
  }
  ButtonWidgetClass itemCardBtn {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   "text color" 0.9961 0.9961 0.9961 1
   style TXListRow
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnCatalogItemClick"
     OnDoubleClick "OnCatalogItemDoubleClick"
    }
   }
  }
  PanelWidgetClass previewBg {
   position 12 8
   hexactpos 1
   vexactpos 1
   size 86 64
   hexactsize 1
   vexactsize 1
   color 0.0588 0.051 0.0392 1
   ignorepointer 1
   style rover_sim_colorable
  }
  ItemPreviewWidgetClass itemPreview {
   position 12 8
   hexactpos 1
   vexactpos 1
   size 86 64
   hexactsize 1
   vexactsize 1
   ignorepointer 1
   clipchildren 1
   scriptclass "ItemPreviewBinding"
   {
    ScriptParamsClass {
     Binding_Item "{{ preview }}"
    }
   }
  }
  TextWidgetClass itemName {
   position 0.08393 14
   hexactpos 0
   vexactpos 1
   size 0.42674 28
   hexactsize 0
   vexactsize 1
   color 0.949 0.9137 0.8471 1
   font "TraderX/datasets/fonts/rajdhanibpx20"
   ignorepointer 1
   "exact text" 1
   "text valign" center
   text "Item Name"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ itemName }}"
    }
   }
  }
  TextWidgetClass itemStock {
   position 0.08393 44
