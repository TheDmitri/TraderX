    }
    ItemPreviewWidgetClass itemPreview {
     position 0.06 0.14
     hexactpos 0
     vexactpos 0
     size 0.88 0.4
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     clipchildren 1
     scriptclass "ItemPreviewBinding"
     {
      ScriptParamsClass {
       Binding_Item "{{ preview }}"
      }
     }
    }
    ImageWidgetClass healthImg {
     position 0.08 0.05
     hexactpos 0
     vexactpos 0
     size 12 12
     hexactsize 1
     vexactsize 1
     color 0.4196 0.5569 0.3529 1
     ignorepointer 1
     image0 "set:traderx_icons image:circle"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
    GridSpacerWidgetClass stockGrid {
     position 0.5 0.03
     hexactpos 0
     vexactpos 0
     size 0.46 32
     hexactsize 0
     vexactsize 1
     ignorepointer 1
     Columns 2
     Rows 1
     Margin 6
     "Size To Content H" 1
     {
      ImageWidgetClass stockIcon {
       size 32 32
       hexactsize 1
       vexactsize 1
       color 0.6039 0.5804 0.5333 1
       ignorepointer 1
       image0 "set:traderx_icons image:stockSimple"
       mode blend
       "src alpha" 1
       "stretch mode" stretch_w_h
      }
      TextWidgetClass stockText {
       color 0.6039 0.5804 0.5333 1
       font "TraderX/datasets/fonts/jet-brains-mono22"
       ignorepointer 1
       style Bold
       "exact text" 1
       "text valign" center
       "size to text h" 1
       text "0/15"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ itemStock }}"
        }
       }
      }
     }
    }
    ImageWidgetClass unselectedIcon {
