       vexactpos 0
       size 1 0.6
       hexactsize 0
       vexactsize 0
       ignorepointer 1
       style TXProgressFill
       color 0.9961 0.9961 0.9961 1
      }
     }
    }
    PanelWidgetClass previewWell {
     position 0.04 0.03
     hexactpos 0
     vexactpos 0
     size 0.92 0.54
     hexactsize 0
     vexactsize 0
     color 0.0235 0.0275 0.0392 1
     ignorepointer 1
