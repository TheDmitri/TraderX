PanelWidgetClass itemCardView {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 300
 hexactsize 0
 vexactsize 1
 ignorepointer 1
 {
  PanelWidgetClass itemCardOutline {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXCardElevated
   color 0.9961 0.9961 0.9961 1
  }
  ButtonWidgetClass itemCardMainBtn {
   position 0.01 0.01
   hexactpos 0
   vexactpos 0
   size 0.98 0.98
   hexactsize 0
   vexactsize 0
   "text color" 0.9961 0.9961 0.9961 1
   style Empty
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnItemCardLeftClick"
     OnDoubleClick "OnItemCardDoubleClick"
     OnRightClick "OnItemCardRightClick"
    }
   }
  }
  PanelWidgetClass itemCardContent {
   position 0.01 0.01
   hexactpos 0
   vexactpos 0
   size 0.98 0.98
   hexactsize 0
   vexactsize 0
   color 0 0 0 0
   ignorepointer 1
   style rover_sim_colorable
   {
    ButtonWidgetClass volumeBtn {
     position 0.01 0.14
     hexactpos 0
     vexactpos 0
     size 9 0.66
     hexactsize 1
     vexactsize 0
     "text color" 0.9961 0.9961 0.9961 1
     style Default
     color 0.9961 0.9961 0.9961 1
