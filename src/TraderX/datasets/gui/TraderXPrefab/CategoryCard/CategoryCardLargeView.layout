GridSpacerWidgetClass categoryCard {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 0.01
 hexactsize 0
 vexactsize 0
 ignorepointer 1
 "Size To Content V" 1
 Columns 1
 Rows 100
 Padding 22
 {
  PanelWidgetClass categoryHeader {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 60
   hexactsize 0
   vexactsize 1
   ignorepointer 1
   {
    PanelWidgetClass categoryCardPanel {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 1
     hexactsize 0
     vexactsize 0
     color 0.0745 0.0627 0.0471 0
     ignorepointer 1
     style rover_sim_colorable
    }
    ButtonWidgetClass categoryBtn {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 0.7 60
     hexactsize 0
     vexactsize 1
     "text color" 0.9961 0.9961 0.9961 1
     style Empty
     color 0.9961 0.9961 0.9961 1
     scriptclass "ButtonBinding"
     {
      ScriptParamsClass {
       OnClick "OnCategoryCardClick"
      }
     }
    }
    ImageWidgetClass categoryIcon {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 1
     hexactsize 1
     vexactsize 1
     color 0 0 0 0
     ignorepointer 1
     visible 0
     image0 "set:traderx_icons image:grid"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
    WrapSpacerWidgetClass categoryTitleRow {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 0.75 60
     hexactsize 0
     vexactsize 1
     ignorepointer 1
     Padding 19
     {
      ImageWidgetClass favStarIcon {
       size 30 56
       hexactsize 1
       vexactsize 1
       color 0.8784 0.6392 0.2275 1
       ignorepointer 1
       visible 0
       image0 "set:traderx_icons image:star_full"
       mode blend
       "src alpha" 1
       "stretch mode" stretch_w_h
      }
      TextWidgetClass CategoryName {
       size 1 57
       hexactsize 1
       vexactsize 1
       color 0.949 0.9137 0.8471 1
       font "TraderX/datasets/fonts/antonpx41"
       ignorepointer 1
       "exact text" 1
       "text valign" bottom
       "size to text h" 1
       text "PACKAGED FOOD"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ category_name | uppercase }}"
        }
       }
      }
      GridSpacerWidgetClass itemCountCol {
       size 1 54
       hexactsize 1
       vexactsize 1
       ignorepointer 1
       Columns 1
       Rows 2
       "Size To Content H" 1
       Padding 0
       {
        PanelWidgetClass itemCountPad {
         size 1 27
         hexactsize 1
         vexactsize 1
         color 0 0 0 0
         ignorepointer 1
         style rover_sim_colorable
        }
        TextWidgetClass itemCountText {
         size 1 27
         hexactsize 1
         vexactsize 1
         color 0.6392 0.5725 0.4627 1
         font "TraderX/datasets/fonts/rajdhanibpx18"
         ignorepointer 1
         "exact text" 1
         "text valign" center
         "size to text h" 1
         text "10 items"
         scriptclass "TextBinding"
         {
          ScriptParamsClass {
           Binding_Expression "{{ item_count }}"
          }
         }
        }
       }
      }
     }
    }
    PanelWidgetClass dropdownParentPanel {
     position 0.10969 1
     hexactpos 0
     vexactpos 1
     size 0.13711 43
     hexactsize 0
     vexactsize 1
     halign right_ref
     ignorepointer 1
     {
      ButtonWidgetClass sortByBtn {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 1 1
       hexactsize 0
       vexactsize 0
       "text color" 0.9961 0.9961 0.9961 1
       style TXBtnDefault
       color 0.9961 0.9961 0.9961 1
       scriptclass "ButtonBinding"
       {
        TextWidgetClass sortLabel {
         position 17 0
         hexactpos 1
         vexactpos 0
         size 80 43
         hexactsize 1
         vexactsize 1
         color 0.7608 0.7098 0.6118 1
         font "TraderX/datasets/fonts/rajdhanibpx17"
         ignorepointer 1
         "exact text" 1
         "text valign" center
         text "#tpm_price"
        }
        ImageWidgetClass croissantIcon {
         position 17 0
         hexactpos 1
         vexactpos 0
         size 17 17
         hexactsize 1
         vexactsize 1
         halign right_ref
         valign center_ref
         color 0.7608 0.7098 0.6118 1
         ignorepointer 1
         image0 "set:traderx_icons image:chevron_down"
         mode blend
         "src alpha" 1
         "stretch mode" stretch_w_h
        }
        ImageWidgetClass decroissantIcon {
         position 17 0
         hexactpos 1
         vexactpos 0
         size 17 17
         hexactsize 1
         vexactsize 1
         halign right_ref
         valign center_ref
         color 0.7608 0.7098 0.6118 1
         rotation 180
         ignorepointer 1
         visible 0
         image0 "set:traderx_icons image:chevron_down"
         mode blend
         "src alpha" 1
         "stretch mode" stretch_w_h
        }
       }
       {
        ScriptParamsClass {
         OnClick "OnSortClick"
        }
       }
      }
      ButtonWidgetClass collapseBtn {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 1 1
       hexactsize 1
       vexactsize 1
       "text color" 0.9961 0.9961 0.9961 1
       visible 0
       style Empty
       color 0.9961 0.9961 0.9961 1
       scriptclass "ButtonBinding"
       {
        ScriptParamsClass {
         OnClick "OnCollapseClick"
        }
       }
      }
     }
    }
    PanelWidgetClass licenseDimPanel {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 1
     hexactsize 0
     vexactsize 0
     color 0.0588 0.051 0.0392 0.6
     ignorepointer 1
     visible 0
     style rover_sim_colorable
    }
    PanelWidgetClass licensePanel {
     position 0.26508 0
     hexactpos 0
     vexactpos 0
     size 0.38391 60
     hexactsize 0
     vexactsize 1
     halign right_ref
     ignorepointer 1
     visible 0
     {
      ImageWidgetClass lockIcon {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 18 18
       hexactsize 1
       vexactsize 1
       valign center_ref
       color 0.8784 0.4784 0.3882 1
       ignorepointer 1
       image0 "set:traderx_icons image:padlock"
       mode blend
       "src alpha" 1
       "stretch mode" stretch_w_h
      }
      TextWidgetClass lockText {
       position 26 0
       hexactpos 1
       vexactpos 0
       size 0.92857 60
       hexactsize 0
       vexactsize 1
       color 0.8784 0.4784 0.3882 1
       font "TraderX/datasets/fonts/rajdhanibpx17"
       ignorepointer 1
       "exact text" 1
       "text valign" center
       text "Licenses Required: Car Licence"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ license_text }}"
        }
       }
      }
     }
    }
   }
  }
  GridSpacerWidgetClass itemCardGridList {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 0.01
   hexactsize 0
   vexactsize 0
   "Size To Content V" 1
   Columns 1
   Rows 100
   Padding 5
   scriptclass "ComponentWidgetBinding"
   {
    ScriptParamsClass {
     Component_ForEach "{{ _inputItemProducts }}"
     Component_Template "tx-item-card-small"
     Component_ItemProperty "_inputProduct"
    }
   }
  }
  GridSpacerWidgetClass itemCardGridTiles {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 0.01
   hexactsize 0
   vexactsize 0
   "Size To Content V" 1
   Columns 4
   Rows 100
   Padding 17
   scriptclass "ComponentWidgetBinding"
   {
    ScriptParamsClass {
     Component_ForEach "{{ _inputItemProducts }}"
     Component_Template "tx-item-card-large"
     Component_ItemProperty "_inputProduct"
    }
   }
  }
 }
}