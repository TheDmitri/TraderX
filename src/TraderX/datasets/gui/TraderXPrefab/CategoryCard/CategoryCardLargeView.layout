GridSpacerWidgetClass categoryCard {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 0.01
 hexactsize 0
 vexactsize 0
 ignorepointer 1
 "Size To Content V" 1
 Columns 1
 Rows 100
 {
  PanelWidgetClass categoryHeader {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 54
   hexactsize 0
   vexactsize 1
   ignorepointer 1
   {
    PanelWidgetClass categoryCardPanel {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 52
     hexactsize 0
     vexactsize 1
     ignorepointer 1
     style TXCard
     color 0.9961 0.9961 0.9961 1
    }
    ButtonWidgetClass categoryBtn {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 52
     hexactsize 0
     vexactsize 1
     "text color" 0.9961 0.9961 0.9961 1
     style TXCategoryRow
     color 0.9961 0.9961 0.9961 1
     scriptclass "ButtonBinding"
     {
      ScriptParamsClass {
       OnClick "OnCategoryCardClick"
      }
     }
    }
    ImageWidgetClass categoryIcon {
     position 0.01 11
     hexactpos 0
     vexactpos 1
     size 30 30
     hexactsize 1
     vexactsize 1
     color 0.7686 0.6392 0.3529 1
     ignorepointer 1
     image0 "set:traderx_icons image:rifle"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
    ImageWidgetClass favStarIcon {
     position 0.01 11
     hexactpos 0
     vexactpos 1
     size 30 30
     hexactsize 1
     vexactsize 1
     color 0.7686 0.6392 0.3529 1
     ignorepointer 1
     visible 0
     image0 "set:traderx_icons image:star"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
    TextWidgetClass CategoryName {
     position 0.05 0
     hexactpos 0
     vexactpos 0
     size 0.5 52
     hexactsize 0
     vexactsize 1
     "text color" 0.8471 0.8235 0.7529 1
     font "TraderX/datasets/fonts/oswalt16"
     ignorepointer 1
     style Bold
     "exact text" 1
     "text valign" center
     text "Category Name"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ category_name }}"
      }
     }
    }
    TextWidgetClass itemCountText {
     position 0.56 0
     hexactpos 0
     vexactpos 0
     size 0.24 52
     hexactsize 0
     vexactsize 1
     "text color" 0.4157 0.3961 0.3765 1
     font "TraderX/datasets/fonts/jet-brains-mono12"
     ignorepointer 1
     "exact text" 1
     "text valign" center
     "text halign" right
     text "146 items"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ item_count }}"
      }
     }
    }
    PanelWidgetClass dropdownParentPanel {
     position 0.82 0
     hexactpos 0
     vexactpos 0
     size 0.18 52
     hexactsize 0
     vexactsize 1
     ignorepointer 1
     {
      ButtonWidgetClass sortByBtn {
       position 0.1 11
       hexactpos 0
       vexactpos 1
       size 30 30
       hexactsize 1
       vexactsize 1
       "text color" 0.9961 0.9961 0.9961 1
       "text color" 0.8471 0.8235 0.7529 1
       font "TraderX/datasets/fonts/oswalt14"
       "exact text" 1
       style TXBtnIcon
       color 0.9961 0.9961 0.9961 1
       scriptclass "ButtonBinding"
       {
        ImageWidgetClass croissantIcon {
         position 0 0
         hexactpos 0
         vexactpos 0
         size 0.9 0.9
         hexactsize 0
         vexactsize 0
         halign center_ref
         valign center_ref
         color 0.8471 0.8235 0.7529 1
         ignorepointer 1
         image0 "set:traderx_icons image:croissant"
         mode blend
         "src alpha" 1
         "stretch mode" stretch_w_h
        }
        ImageWidgetClass decroissantIcon {
         position 0 0
         hexactpos 0
         vexactpos 0
         size 0.9 0.9
         hexactsize 0
         vexactsize 0
         halign center_ref
         valign center_ref
         color 0.8471 0.8235 0.7529 1
         ignorepointer 1
         visible 0
         image0 "set:traderx_icons image:decroissant"
         mode blend
         "src alpha" 1
         "stretch mode" stretch_w_h
        }
       }
       {
        ScriptParamsClass {
         OnClick "OnSortClick"
        }
       }
      }
      ButtonWidgetClass collapseBtn {
       position 0.55 11
       hexactpos 0
       vexactpos 1
       size 30 30
       hexactsize 1
       vexactsize 1
       "text color" 0.9961 0.9961 0.9961 1
       "text color" 0.8471 0.8235 0.7529 1
       font "TraderX/datasets/fonts/oswalt16"
       "exact text" 1
       style TXBtnIcon
       color 0.9961 0.9961 0.9961 1
       scriptclass "ButtonBinding"
       {
        ImageWidgetClass collapseBtnIcon {
         position 0 0
         hexactpos 0
         vexactpos 0
         size 0.55 0.55
         hexactsize 0
         vexactsize 0
         halign center_ref
         valign center_ref
         ignorepointer 1
         image0 "set:traderx_icons image:chevron_down"
         mode blend
         "src alpha" 1
         "stretch mode" stretch_w_h
        }
       }
       {
        ScriptParamsClass {
         OnClick "OnCollapseClick"
        }
       }
      }
     }
    }
    PanelWidgetClass licensePanel {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 52
     hexactsize 0
     vexactsize 1
     ignorepointer 1
     visible 0
     style TXErrorBox
     color 0.9961 0.9961 0.9961 1
     {
      ImageWidgetClass lockIcon {
       position 0.34 0
       hexactpos 0
       vexactpos 0
       size 36 36
       hexactsize 1
       vexactsize 1
       valign center_ref
       color 0.8471 0.8235 0.7529 1
       ignorepointer 1
       image0 "set:traderx_icons image:padlock"
       mode blend
       "src alpha" 1
       "stretch mode" stretch_w_h
      }
      TextWidgetClass lockText {
       position 0.41 0
       hexactpos 0
       vexactpos 0
       size 0.5 1
       hexactsize 0
       vexactsize 0
       valign center_ref
       color 0.8471 0.8235 0.7529 1
       font "TraderX/datasets/fonts/oswalt22"
       ignorepointer 1
       "text valign" center
       "exact text" 1
       "size to text h" 1
       text "#tpm_licenses_required"
      }
     }
    }
   }
  }
  GridSpacerWidgetClass itemCardGridList {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 0.01
   hexactsize 0
   vexactsize 0
   "Size To Content V" 1
   Columns 1
   Rows 100
   Margin 4
   scriptclass "ComponentWidgetBinding"
   {
    ScriptParamsClass {
     Component_ForEach "{{ _inputItemProducts }}"
     Component_Template "tx-item-card-small"
     Component_ItemProperty "_inputProduct"
    }
   }
  }
  GridSpacerWidgetClass itemCardGridTiles {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 0.01
   hexactsize 0
   vexactsize 0
   "Size To Content V" 1
   Columns 4
   Rows 100
   Margin 6
   scriptclass "ComponentWidgetBinding"
   {
    ScriptParamsClass {
     Component_ForEach "{{ _inputItemProducts }}"
     Component_Template "tx-item-card-large"
     Component_ItemProperty "_inputProduct"
    }
   }
  }
 }
}