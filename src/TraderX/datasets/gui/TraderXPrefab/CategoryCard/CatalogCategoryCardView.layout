GridSpacerWidgetClass categoryCard {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 0.01
 hexactsize 0
 vexactsize 0
 ignorepointer 1
 "Size To Content V" 1
 Columns 1
 Rows 100
 Padding 5
 {
  PanelWidgetClass categoryHeader {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 60
   hexactsize 0
   vexactsize 1
   ignorepointer 1
   {
    PanelWidgetClass categoryCardPanel {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 1
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     style TXCard
     color 0.9961 0.9961 0.9961 1
    }
    ButtonWidgetClass categoryBtn {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 1
     hexactsize 0
     vexactsize 0
     "text color" 0.9961 0.9961 0.9961 1
     style Empty
     color 0.9961 0.9961 0.9961 1
     scriptclass "ButtonBinding"
     {
      ScriptParamsClass {
       OnClick "OnCategoryCardClick"
      }
     }
    }
    ImageWidgetClass categoryIcon {
     position 22 0
     hexactpos 1
     vexactpos 0
     size 24 24
     hexactsize 1
     vexactsize 1
     valign center_ref
     color 0.851 0.4627 0.1843 1
     ignorepointer 1
     image0 "set:traderx_icons image:grid"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
    TextWidgetClass CategoryName {
     position 0.04623 0
     hexactpos 0
     vexactpos 0
     size 0.42674 60
     hexactsize 0
     vexactsize 1
     color 0.949 0.9137 0.8471 1
     font "TraderX/datasets/fonts/rajdhanibpx22"
     ignorepointer 1
     "exact text" 1
     "text valign" center
     text "Category Name"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ category_name }}"
      }
     }
    }
    TextWidgetClass itemCountText {
     position 0.09246 0
     hexactpos 0
     vexactpos 0
     size 0.14225 60
     hexactsize 0
     vexactsize 1
     halign right_ref
     color 0.6392 0.5725 0.4627 1
     font "TraderX/datasets/fonts/monopx16"
     ignorepointer 1
     "exact text" 1
     "text valign" center
     "text halign" right
     text "146 items"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ item_count }}"
      }
     }
    }
    PanelWidgetClass dropdownParentPanel {
     position 14 0
     hexactpos 1
     vexactpos 0
     size 0.07112 60
     hexactsize 0
     vexactsize 1
     halign right_ref
     ignorepointer 1
     {
      ButtonWidgetClass sortByBtn {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 38 38
       hexactsize 1
       vexactsize 1
       valign center_ref
       "text color" 0.9961 0.9961 0.9961 1
       style TXBtnIcon
       color 0.9961 0.9961 0.9961 1
       scriptclass "ButtonBinding"
       {
        ImageWidgetClass croissantIcon {
         position 0 0
         hexactpos 0
         vexactpos 0
         size 17 17
         hexactsize 1
         vexactsize 1
         halign center_ref
         valign center_ref
         color 0.7608 0.7098 0.6118 1
         ignorepointer 1
         image0 "set:traderx_icons image:croissant"
         mode blend
         "src alpha" 1
         "stretch mode" stretch_w_h
        }
        ImageWidgetClass decroissantIcon {
         position 0 0
         hexactpos 0
         vexactpos 0
         size 17 17
         hexactsize 1
         vexactsize 1
         halign center_ref
         valign center_ref
         color 0.7608 0.7098 0.6118 1
         ignorepointer 1
         visible 0
         image0 "set:traderx_icons image:decroissant"
         mode blend
         "src alpha" 1
         "stretch mode" stretch_w_h
        }
       }
       {
        ScriptParamsClass {
         OnClick "OnSortClick"
        }
       }
      }
      ButtonWidgetClass collapseBtn {
       position 48 0
       hexactpos 1
       vexactpos 0
       size 38 38
       hexactsize 1
       vexactsize 1
       valign center_ref
       "text color" 0.9961 0.9961 0.9961 1
       style TXBtnIcon
       color 0.9961 0.9961 0.9961 1
       scriptclass "ButtonBinding"
       {
        ImageWidgetClass collapseBtnIcon {
         position 0 0
         hexactpos 0
         vexactpos 0
         size 17 17
         hexactsize 1
         vexactsize 1
         halign center_ref
         valign center_ref
         color 0.7608 0.7098 0.6118 1
         ignorepointer 1
         image0 "set:traderx_icons image:chevron_down"
         mode blend
         "src alpha" 1
         "stretch mode" stretch_w_h
        }
       }
       {
        ScriptParamsClass {
         OnClick "OnCollapseClick"
        }
       }
      }
     }
    }
    PanelWidgetClass licenseDimPanel {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 1
     hexactsize 0
     vexactsize 0
     color 0.0588 0.051 0.0392 0.6
     ignorepointer 1
     visible 0
     style rover_sim_colorable
    }
    PanelWidgetClass licensePanel {
     position 0.25605 0
     hexactpos 0
     vexactpos 0
     size 0.29872 60
     hexactsize 0
     vexactsize 1
     halign right_ref
     ignorepointer 1
     visible 0
     {
      ImageWidgetClass lockIcon {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 18 18
       hexactsize 1
       vexactsize 1
       valign center_ref
       color 0.8784 0.4784 0.3882 1
       ignorepointer 1
       image0 "set:traderx_icons image:padlock"
       mode blend
       "src alpha" 1
       "stretch mode" stretch_w_h
      }
      TextWidgetClass lockText {
       position 26 0
       hexactpos 1
       vexactpos 0
       size 0.92857 60
       hexactsize 0
       vexactsize 1
       color 0.8784 0.4784 0.3882 1
       font "TraderX/datasets/fonts/rajdhanibpx17"
       ignorepointer 1
       "exact text" 1
       "text valign" center
       text "Licenses Required: Car Licence"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ license_text }}"
        }
       }
      }
     }
    }
   }
  }
  GridSpacerWidgetClass itemCardGridList {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 0.01
   hexactsize 0
   vexactsize 0
   "Size To Content V" 1
   Columns 1
   Rows 100
   Padding 5
   scriptclass "ComponentWidgetBinding"
   {
    ScriptParamsClass {
     Component_ForEach "{{ _inputCatalogProducts }}"
     Component_Template "tx-catalog-item-card"
     Component_ItemProperty "_inputProduct"
    }
   }
  }
  GridSpacerWidgetClass itemCardGridTiles {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 0.01
   hexactsize 0
   vexactsize 0
   "Size To Content V" 1
   Columns 5
   Rows 100
   Padding 17
   scriptclass "ComponentWidgetBinding"
   {
    ScriptParamsClass {
     Component_ForEach "{{ _inputCatalogProducts }}"
     Component_Template "tx-catalog-item-card-grid"
     Component_ItemProperty "_inputProduct"
    }
   }
  }
 }
}