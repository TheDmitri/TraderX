GridSpacerWidgetClass CheckoutCardView {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 0.01
 hexactsize 0
 vexactsize 0
 ignorepointer 1
 "Size To Content V" 1
 Columns 1
 Rows 100
 Padding 0
 {
  PanelWidgetClass checkoutMainRow {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 80
   hexactsize 0
   vexactsize 1
   ignorepointer 1
   style TXRowRule
   color 0.9961 0.9961 0.9961 1
   {
    TextWidgetClass productName {
     position 24 14
     hexactpos 1
     vexactpos 1
     size 0.39474 26
     hexactsize 0
     vexactsize 1
     color 0.949 0.9137 0.8471 1
     font "TraderX/datasets/fonts/rajdhanibpx20"
     ignorepointer 1
     "exact text" 1
     "text valign" center
     text "Item Name"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ product_name_text }}"
      }
     }
    }
    TextWidgetClass productUnit {
     position 24 44
     hexactpos 1
     vexactpos 1
     size 0.39474 21
     hexactsize 0
     vexactsize 1
     color 0.6392 0.5725 0.4627 1
     font "TraderX/datasets/fonts/monopx17"
     ignorepointer 1
     "exact text" 1
     "text valign" center
     text "€ 5 each"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ product_unit_text }}"
      }
     }
    }
    PanelWidgetClass qtyStepper {
     position 0.29605 0
     hexactpos 0
     vexactpos 0
     size 0.24123 41
     hexactsize 0
     vexactsize 1
     halign right_ref
     valign center_ref
     ignorepointer 1
     style TXFrame
     color 0.9961 0.9961 0.9961 1
     {
      ButtonWidgetClass btnMinus {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 38 41
       hexactsize 1
       vexactsize 1
       "text color" 0.9961 0.9961 0.9961 1
       style Empty
       color 0.9961 0.9961 0.9961 1
       scriptclass "ButtonBinding"
       {
        ImageWidgetClass btnMinusIcon {
         position 0 0
         hexactpos 0
         vexactpos 0
         size 16 16
         hexactsize 1
         vexactsize 1
         halign center_ref
         valign center_ref
         color 0.7608 0.7098 0.6118 1
         ignorepointer 1
         image0 "set:traderx_icons image:minus"
         mode blend
         "src alpha" 1
         "stretch mode" stretch_w_h
        }
       }
       {
        ScriptParamsClass {
         OnClick "OnMinusClick"
        }
       }
      }
      TextWidgetClass productQty {
       position 38 0
       hexactpos 1
       vexactpos 0
       size 34 41
       hexactsize 1
       vexactsize 1
       color 0.949 0.9137 0.8471 1
       font "TraderX/datasets/fonts/monopx18"
       ignorepointer 1
       "exact text" 1
       "text halign" center
       "text valign" center
       text "1"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ product_quantity_text }}"
        }
       }
      }
      ButtonWidgetClass btnPlus {
       position 0.65455 0
       hexactpos 0
       vexactpos 0
       size 38 41
       hexactsize 1
       vexactsize 1
       "text color" 0.9961 0.9961 0.9961 1
       style Empty
       color 0.9961 0.9961 0.9961 1
       scriptclass "ButtonBinding"
       {
        ImageWidgetClass btnPlusIcon {
         position 0 0
         hexactpos 0
         vexactpos 0
         size 16 16
         hexactsize 1
         vexactsize 1
         halign center_ref
         valign center_ref
         color 0.7608 0.7098 0.6118 1
         ignorepointer 1
         image0 "set:traderx_icons image:add"
         mode blend
         "src alpha" 1
         "stretch mode" stretch_w_h
        }
       }
       {
        ScriptParamsClass {
         OnClick "OnPlusClick"
        }
       }
      }
     }
    }
    TextWidgetClass productPrice {
     position 24 0
     hexactpos 1
     vexactpos 0
     size 0.2193 80
     hexactsize 0
     vexactsize 1
     halign right_ref
     color 0.949 0.9137 0.8471 1
     font "TraderX/datasets/fonts/monopx19"
     ignorepointer 1
     "exact text" 1
     "text valign" center
     "text halign" right
     text "€ 10"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ product_price_text }}"
      }
     }
    }
    ButtonWidgetClass removeBtn {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 1
     hexactsize 1
     vexactsize 1
     "text color" 0.9961 0.9961 0.9961 1
     visible 0
     style Empty
     color 0.9961 0.9961 0.9961 1
     scriptclass "ButtonBinding"
     {
      ScriptParamsClass {
       OnClick "OnRemoveClick"
      }
     }
    }
   }
  }
  ButtonWidgetClass presetToggleBtn {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 30
   hexactsize 0
   vexactsize 1
   visible 0
   style TXListRow
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    TextWidgetClass presetToggleLabel {
     position 0.03 0
     hexactpos 0
     vexactpos 0
     size 0.88 1
     hexactsize 0
     vexactsize 0
     color 0.851 0.4627 0.1843 1
     font "TraderX/datasets/fonts/rajdhani13"
     ignorepointer 1
     style Bold
     "exact text" 1
     "text valign" center
     text "Presets"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ preset_toggle_label }}"
      }
     }
    }
    ImageWidgetClass presetChevron {
     position 0.93 0
     hexactpos 0
     vexactpos 0
     size 18 18
     hexactsize 1
     vexactsize 1
     valign center_ref
     color 0.6392 0.5725 0.4627 1
     ignorepointer 1
     image0 "set:traderx_icons image:chevron_down"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
   }
   {
    ScriptParamsClass {
     OnClick "OnPresetToggle"
    }
   }
  }
  GridSpacerWidgetClass presetOptionsGrid {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 0.01
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   "Size To Content V" 1
   Columns 1
   Rows 100
   Padding 2
   visible 0
   scriptclass "ComponentWidgetBinding"
   {
    ScriptParamsClass {
     Component_ForEach "{{ _presetOptions }}"
     Component_Template "tx-checkout-preset-option"
     Component_ItemProperty "_inputOption"
    }
   }
  }
 }
}