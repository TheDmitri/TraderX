PanelWidgetClass CheckoutCardView {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 60
 hexactsize 0
 vexactsize 1
 ignorepointer 1
 style blank
 color 0.9961 0.9961 0.9961 1
 {
  TextWidgetClass productName {
   position 0.03 0.06
   hexactpos 0
   vexactpos 0
   size 0.56 0.44
   hexactsize 0
   vexactsize 0
   color 0.8471 0.8235 0.7529 1
   font "TraderX/datasets/fonts/oswalt14"
   ignorepointer 1
   style Bold
   "exact text" 1
   "text valign" center
   text "Item Name"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ product_name_text }}"
    }
   }
  }
  TextWidgetClass productPrice {
   position 0.03 0.52
   hexactpos 0
   vexactpos 0
   size 0.56 0.4
   hexactsize 0
   vexactsize 0
   color 0.7686 0.6392 0.3529 1
   font "TraderX/datasets/fonts/jet-brains-mono14"
   ignorepointer 1
   "exact text" 1
   "text valign" center
   text "1,250"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ product_price_text }}"
    }
   }
  }
  ButtonWidgetClass btnMinus {
   position 0.6 0
   hexactpos 0
   vexactpos 0
   size 32 32
   hexactsize 1
   vexactsize 1
   valign center_ref
   "text color" 0.9961 0.9961 0.9961 1
   "text color" 0.8471 0.8235 0.7529 1
   font "TraderX/datasets/fonts/oswalt16"
   style TXBtnIcon
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ImageWidgetClass btnMinusIcon {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 22 22
     hexactsize 1
     vexactsize 1
     halign center_ref
     valign center_ref
     ignorepointer 1
     image0 "set:traderx_icons image:minus"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
   }
   {
    ScriptParamsClass {
     OnClick "OnMinusClick"
    }
   }
  }
  TextWidgetClass productQty {
   position 0.68 0
   hexactpos 0
   vexactpos 0
   size 0.14 1
   hexactsize 0
   vexactsize 0
   color 0.8471 0.8235 0.7529 1
   font "TraderX/datasets/fonts/jet-brains-mono16"
   ignorepointer 1
   style Bold
   "exact text" 1
   "text halign" center
   "text valign" center
   text "1"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ product_quantity_text }}"
    }
   }
  }
  ButtonWidgetClass btnPlus {
   position 0.8 0
   hexactpos 0
   vexactpos 0
   size 32 32
   hexactsize 1
   vexactsize 1
   valign center_ref
   "text color" 0.9961 0.9961 0.9961 1
   "text color" 0.8471 0.8235 0.7529 1
   font "TraderX/datasets/fonts/oswalt16"
   style TXBtnIcon
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ImageWidgetClass btnPlusIcon {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 22 22
     hexactsize 1
     vexactsize 1
     halign center_ref
     valign center_ref
     ignorepointer 1
     image0 "set:traderx_icons image:add"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
   }
   {
    ScriptParamsClass {
     OnClick "OnPlusClick"
    }
   }
  }
  ButtonWidgetClass removeBtn {
   position 0.9 0
   hexactpos 0
   vexactpos 0
   size 32 32
   hexactsize 1
   vexactsize 1
   valign center_ref
   "text color" 0.9961 0.9961 0.9961 1
   "text color" 0.7882 0.1882 0.1882 1
   font "TraderX/datasets/fonts/oswalt16"
   style TXBtnIcon
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ImageWidgetClass removeBtnIcon {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 22 22
     hexactsize 1
     vexactsize 1
     halign center_ref
     valign center_ref
     color 0.9412 0.3961 0.2902 1
     ignorepointer 1
     image0 "set:traderx_icons image:trash"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
   }
   {
    ScriptParamsClass {
     OnClick "OnRemoveClick"
    }
   }
  }
 }
}