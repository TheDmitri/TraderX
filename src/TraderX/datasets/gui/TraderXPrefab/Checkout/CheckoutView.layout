PanelWidgetClass CheckOutView {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 ignorepointer 1
 style TXCard
 color 0.9961 0.9961 0.9961 1
 {
  PanelWidgetClass checkoutHeader {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 0.08
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXSurface
   color 0.9961 0.9961 0.9961 1
   {
    TextWidgetClass checkoutTitle {
     position 0.06 0
     hexactpos 0
     vexactpos 0
     size 0.7 1
     hexactsize 0
     vexactsize 0
     "text color" 0.8471 0.8235 0.7529 1
     font "TraderX/datasets/fonts/oswalt16"
     ignorepointer 1
     style Bold
     "exact text" 1
     "text valign" center
     text "#tpm_shopping_cart"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ checkout_label }}"
      }
     }
    }
    ButtonWidgetClass clearCheckoutBtn {
     position 0.9 0.18
     hexactpos 0
     vexactpos 0
     size 32 32
     hexactsize 1
     vexactsize 1
     "text color" 0.9961 0.9961 0.9961 1
     "text color" 0.7882 0.1882 0.1882 1
     font "TraderX/datasets/fonts/oswalt16"
     style TXBtnIcon
     color 0.9961 0.9961 0.9961 1
     scriptclass "ButtonBinding"
     {
      ImageWidgetClass ImageWidget0 {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 0.69 0.7
       hexactsize 0
       vexactsize 0
       halign center_ref
       valign center_ref
       color 0.9412 0.3961 0.2902 1
       ignorepointer 1
       image0 "set:traderx_icons image:delete"
       mode blend
       "src alpha" 1
       "stretch mode" stretch_w_h
      }
     }
     {
      ScriptParamsClass {
       OnClick "OnClearCheckoutClick"
      }
     }
    }
   }
  }
  ScrollWidgetClass CheckoutScroll {
   position 0.02 0.09
   hexactpos 0
   vexactpos 0
   size 0.96 0.58
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   "Scrollbar V" 1
   {
    PanelWidgetClass emptyCartPanel {
     position 0 0.2
     hexactpos 0
     vexactpos 0
     size 1 0.4
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     {
      ImageWidgetClass emptyCartIcon {
       position 0.38 0
       hexactpos 0
       vexactpos 0
       size 0.24 0.4
       hexactsize 0
       vexactsize 0
       color 0.102 0.1176 0.1569 1
       ignorepointer 1
       halign center_ref
       image0 "set:traderx_icons image:checkout"
       mode blend
       "src alpha" 1
       "stretch mode" stretch_w_h
      }
      TextWidgetClass emptyCartText {
       position 0 0.5
       hexactpos 0
       vexactpos 0
       size 1 0.3
       hexactsize 0
       vexactsize 0
       color 0.4157 0.3961 0.3765 1
       font "TraderX/datasets/fonts/oswalt14"
       ignorepointer 1
       "exact text" 1
       "text halign" center
       text "#tpm_add_items_to_cart"
      }
     }
    }
    GridSpacerWidgetClass checkoutGrid {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 0.01
     hexactsize 0
     vexactsize 0
     "Size To Content V" 1
     Columns 1
     Rows 100
     Margin 4
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_ForEach "{{ _inputCheckoutItems }}"
       Component_Template "tx-checkout-card"
       Component_ItemProperty "_inputProduct"
      }
     }
    }
   }
  }
  PanelWidgetClass checkoutFooter {
   position 0 0.68
   hexactpos 0
   vexactpos 0
   size 1 0.32
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXSurface
   color 0.9961 0.9961 0.9961 1
   {
    PanelWidgetClass rowToPay {
     position 0.04 0.04
     hexactpos 0
     vexactpos 0
     size 0.92 0.2
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     {
      TextWidgetClass LabelTotal {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 0.4 1
       hexactsize 0
       vexactsize 0
       "text color" 0.4157 0.3961 0.3765 1
       font "TraderX/datasets/fonts/oswalt14"
       ignorepointer 1
       "exact text" 1
       "text valign" center
       text "#tpm_to_pay"
      }
      TextWidgetClass totalAmount {
       position 0.3 0
       hexactpos 0
       vexactpos 0
       size 0.7 1
       hexactsize 0
       vexactsize 0
       "text color" 0.7686 0.6392 0.3529 1
       font "TraderX/datasets/fonts/jet-brains-mono28"
       ignorepointer 1
       style Bold
       "text valign" center
       "text halign" right
       text "13,350"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ total_amount }}"
        }
       }
      }
     }
    }
    PanelWidgetClass rowWallet {
     position 0.04 0.28
     hexactpos 0
     vexactpos 0
     size 0.92 0.14
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     {
      ImageWidgetClass walletIcon {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 24 24
       hexactsize 1
       vexactsize 1
       valign center_ref
       color 0.6039 0.5804 0.5333 1
       ignorepointer 1
       image0 "set:traderx_icons image:wallet"
       mode blend
       "src alpha" 1
       "stretch mode" stretch_w_h
      }
      TextWidgetClass moneyAmount {
       position 0.4 0
       hexactpos 0
       vexactpos 0
       size 0.6 1
       hexactsize 0
       vexactsize 0
       "text color" 0.8471 0.8235 0.7529 1
       font "TraderX/datasets/fonts/jet-brains-mono16"
       ignorepointer 1
       "text valign" center
       "text halign" right
       text "34,000"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ money_amount }}"
        }
       }
      }
     }
    }
    ButtonWidgetClass purchaseBtn {
     position 0.03 0.48
     hexactpos 0
     vexactpos 0
     size 0.94 0.46
     hexactsize 0
     vexactsize 0
     "text color" 0.9961 0.9961 0.9961 1
     "text color" 0.8471 0.8235 0.7529 1
     font "TraderX/datasets/fonts/oswalt22"
     style TXBtnPrimary
     color 0.9961 0.9961 0.9961 1
     scriptclass "ButtonBinding"
     {
      GridSpacerWidgetClass purchaseBtnRow {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 1 0.01
       hexactsize 0
       vexactsize 0
       halign center_ref
       valign center_ref
       ignorepointer 1
       Columns 2
       Rows 1
       Margin 8
       "Size To Content H" 1
       "Size To Content V" 1
       {
        ImageWidgetClass purchaseBtnIcon {
         size 32 32
         hexactsize 1
         vexactsize 1
         halign center_ref
         valign center_ref
         color 0.8471 0.8235 0.7529 1
         ignorepointer 1
         image0 "set:traderx_icons image:checkout"
         mode blend
         "src alpha" 1
         "stretch mode" stretch_w_h
        }
        TextWidgetClass purchaseBtnText {
         size 0.5 32
         hexactsize 0
         vexactsize 1
         color 0.8471 0.8235 0.7529 1
         font "TraderX/datasets/fonts/oswalt22"
         ignorepointer 1
         style Bold
         "text valign" center
         "text halign" center
         "size to text h" 1
         text "#tpm_purchase"
         scriptclass "TextBinding"
         {
          ScriptParamsClass {
           Binding_Expression "{{ checkout_btn_text }}"
          }
         }
        }
       }
      }
     }
     {
      ScriptParamsClass {
       OnClick "OnCheckoutClick"
      }
     }
    }
   }
  }
 }
}