PanelWidgetClass CheckOutView {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 ignorepointer 1
 style TXSideRight
 color 0.9961 0.9961 0.9961 1
 {
  PanelWidgetClass checkoutHeader {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 77
   hexactsize 0
   vexactsize 1
   ignorepointer 1
   style TXRowRule
   color 0.9961 0.9961 0.9961 1
   {
    TextWidgetClass checkoutTitle {
     position 24 0
     hexactpos 1
     vexactpos 0
     size 0.54825 77
     hexactsize 0
     vexactsize 1
     color 0.949 0.9137 0.8471 1
     font "TraderX/datasets/fonts/antonpx29"
     ignorepointer 1
     "exact text" 1
     "text valign" center
     text "CART"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ checkout_title }}"
      }
     }
    }
    ButtonWidgetClass clearCheckoutBtn {
     position 14 17
     hexactpos 1
     vexactpos 1
     size 0.24123 43
     hexactsize 0
     vexactsize 1
     halign right_ref
     "text color" 0.9961 0.9961 0.9961 1
     style Empty
     color 0.9961 0.9961 0.9961 1
     scriptclass "ButtonBinding"
     {
      TextWidgetClass clearCheckoutText {
       position 10 0
       hexactpos 1
       vexactpos 0
       size 0.90909 43
       hexactsize 0
       vexactsize 1
       halign right_ref
       color 0.7608 0.7098 0.6118 1
       font "TraderX/datasets/fonts/rajdhanibpx17"
       ignorepointer 1
       "exact text" 1
       "text valign" center
       "text halign" right
       text "#tpm_clear_all"
      }
     }
     {
      ScriptParamsClass {
       OnClick "OnClearCheckoutClick"
      }
     }
    }
   }
  }
  ScrollWidgetClass CheckoutScroll {
   position 0 78
   hexactpos 0
   vexactpos 1
   size 1 646
   hexactsize 0
   vexactsize 1
   ignorepointer 1
   "Scrollbar V" 1
   {
    GridSpacerWidgetClass checkoutGrid {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 0.01
     hexactsize 0
     vexactsize 0
     "Size To Content V" 1
     Columns 1
     Rows 100
     Padding 0
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_ForEach "{{ _inputCheckoutItems }}"
       Component_Template "tx-checkout-card"
       Component_ItemProperty "_inputProduct"
      }
     }
    }
   }
  }
