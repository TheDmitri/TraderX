GridSpacerWidgetClass rootFrame {
 ignorepointer 1
 color 0.047 0.055 0.078 1
 position 10 10
 size 300 60
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 priority 999
 style Colorable
 Padding 5
 Margin 8
 "Size To Content H" 1
 Columns 1
 Rows 1
 {
  TextWidgetClass titleText {
   ignorepointer 1
   color 0.949 0.933 0.894 1
   position 8 0
   size 284 60
   hexactpos 1
   vexactpos 0
   hexactsize 1
   vexactsize 1
   scriptclass "TextBinding"
   style Bold
   text "All"
   font "TraderX/datasets/fonts/oswalt16"
   "exact text" 1
   "size to text h" 1
   "text halign" center
   "text valign" center
   {
    ScriptParamsClass {
     Binding_Expression "{{ title }}"
    }
   }
  }
 }
}