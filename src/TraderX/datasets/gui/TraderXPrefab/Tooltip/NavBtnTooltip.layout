GridSpacerWidgetClass rootFrame {
 position 10 10
 hexactpos 1
 vexactpos 1
 size 120 34
 hexactsize 1
 vexactsize 1
 "Size To Content V" 1
 "Size To Content H" 1
 Columns 1
 Rows 1
 Padding 8
 Margin 0
 priority 999
 style TXCardElevated
 color 0.9961 0.9961 0.9961 1
 {
  TextWidgetClass titleText {
   size 100 20
   hexactsize 1
   vexactsize 1
   halign center_ref
   valign center_ref
   color 0.7686 0.6392 0.3529 1
   font "TraderX/datasets/fonts/oswalt14"
   ignorepointer 1
   "text valign" center
   "text halign" center
   "size to text h" 1
   "size to text v" 1
   text "All"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ title }}"
    }
   }
  }
 }
}