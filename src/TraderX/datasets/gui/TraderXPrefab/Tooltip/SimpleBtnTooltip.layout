GridSpacerWidgetClass rootFrame {
 position 10 10
 hexactpos 1
 vexactpos 1
 size 160 36
 hexactsize 1
 vexactsize 1
 color 0.0588 0.051 0.0392 1
 priority 999
 ignorepointer 1
 "Size To Content V" 1
 "Size To Content H" 1
 Columns 1
 Rows 1
 Margin 6
 Padding 8
 style Colorable
 {
  TextWidgetClass TextWidget0 {
   size 48 22
   hexactsize 1
   vexactsize 1
   halign center_ref
   valign center_ref
   color 0.949 0.9137 0.8471 1
   font "TraderX/datasets/fonts/rajdhani16"
   ignorepointer 1
   style Bold
   "text valign" center
   "text halign" center
   "size to text h" 1
   "size to text v" 1
   text "Customize"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ title }}"
    }
   }
  }
 }
}