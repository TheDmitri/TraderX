PanelWidgetClass modalRoot {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 halign center_ref
 valign center_ref
 priority 999
 {
  PanelWidgetClass backdrop {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   color 0 0 0 0.7843
   style rover_sim_colorable
  }
  PanelWidgetClass modalCard {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 0.3 0.3
   hexactsize 0
   vexactsize 0
   halign center_ref
   valign center_ref
   style TXCard
   color 0.9961 0.9961 0.9961 1
   {
    TextWidgetClass title {
     position 0 0.07
     hexactpos 0
     vexactpos 0
     size 1 0.14
     hexactsize 0
     vexactsize 0
     halign center_ref
     color 0.8471 0.8235 0.7529 1
     font "TraderX/datasets/fonts/oswalt22"
     ignorepointer 1
     "exact text" 1
     "text halign" center
     "text valign" center
     text "#tpm_create_new_preset"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ modal_title }}"
      }
     }
    }
    TextWidgetClass nameLabel {
     position 0.07 0.27
     hexactpos 0
     vexactpos 0
     size 0.86 0.09
     hexactsize 0
     vexactsize 0
     color 0.6039 0.5804 0.5333 1
     font "TraderX/datasets/fonts/oswalt16"
     ignorepointer 1
     "exact text" 1
     "text valign" center
     text "#tpm_choose_preset_name"
    }
    EditBoxWidgetClass nameInput {
     position 0.07 0.38
     hexactpos 0
     vexactpos 0
     size 0.86 0.16
     hexactsize 0
     vexactsize 0
     font "TraderX/datasets/fonts/oswalt16"
     "exact text" 1
     style TXInputField
     color 0.9961 0.9961 0.9961 1
     scriptclass "EditBoxBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ input_text }}"
       Two_Way_Binding 1
       OnChange "OnInputTextChanged"
      }
     }
    }
    TextWidgetClass errorText {
     position 0.07 0.57
     hexactpos 0
     vexactpos 0
     size 0.86 0.09
     hexactsize 0
     vexactsize 0
     color 0.9412 0.3961 0.2902 1
     font "TraderX/datasets/fonts/oswalt14"
     ignorepointer 1
     "exact text" 1
     "text valign" center
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ error_text }}"
      }
     }
    }
    ButtonWidgetClass cancelBtn {
     position 0.07 0.74
     hexactpos 0
     vexactpos 0
     size 0.4 0.18
     hexactsize 0
     vexactsize 0
     "text color" 0.9961 0.9961 0.9961 1
     style TXBtnDefault
     color 0.9961 0.9961 0.9961 1
     text "#tpm_cancel"
     scriptclass "ButtonBinding"
     {
      ScriptParamsClass {
       OnClick "OnCancelClick"
      }
     }
    }
    ButtonWidgetClass confirmBtn {
     position 0.53 0.74
     hexactpos 0
     vexactpos 0
     size 0.4 0.18
     hexactsize 0
     vexactsize 0
     "text color" 0.9961 0.9961 0.9961 1
     style TXBtnPrimary
     color 0.9961 0.9961 0.9961 1
     text "#tpm_confirm"
     scriptclass "ButtonBinding"
     {
      ScriptParamsClass {
       OnClick "OnConfirmClick"
      }
     }
    }
   }
  }
 }
}