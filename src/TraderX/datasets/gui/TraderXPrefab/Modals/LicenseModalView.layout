FrameWidgetClass modalRoot {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 halign center_ref
 valign center_ref
 {
  PanelWidgetClass backdrop {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   color 0.0588 0.051 0.0392 0.8
   style rover_sim_colorable
  }
  PanelWidgetClass modalCard {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 0.3125 330
   hexactsize 0
   vexactsize 1
   halign center_ref
   valign center_ref
   style TXCard
   color 0.9961 0.9961 0.9961 1
   {
    ImageWidgetClass lockIcon {
     position 28 30
     hexactpos 1
     vexactpos 1
     size 29 29
     hexactsize 1
     vexactsize 1
     color 0.8784 0.4784 0.3882 1
     ignorepointer 1
     image0 "set:traderx_icons image:padlock"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
    TextWidgetClass title {
     position 0.11667 23
     hexactpos 0
     vexactpos 1
     size 0.83333 42
     hexactsize 0
     vexactsize 1
     color 0.949 0.9137 0.8471 1
     font "TraderX/datasets/fonts/antonpx29"
     ignorepointer 1
     "exact text" 1
     "text valign" center
     text "LICENSES REQUIRED"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ title }}"
      }
     }
    }
    RichTextWidgetClass textContent {
     position 28 84
     hexactpos 1
     vexactpos 1
     size 0.90667 60
     hexactsize 0
     vexactsize 1
     color 0.7608 0.7098 0.6118 1
     font "TraderX/datasets/fonts/rajdhanipx19"
     ignorepointer 1
     "exact text" 1
     wrap 1
     text "You don't have the required license to access this trader."
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ content }}"
      }
     }
    }
    RichTextWidgetClass licensesList {
     position 28 150
     hexactpos 1
     vexactpos 1
     size 0.90667 70
     hexactsize 0
     vexactsize 1
     color 0.9098 0.5373 0.2902 1
     font "TraderX/datasets/fonts/rajdhanibpx19"
     ignorepointer 1
     "exact text" 1
     wrap 1
     text "- Car Licence"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ licensesList }}"
      }
     }
    }
    PanelWidgetClass closeBtnHost {
     position 28 28
     hexactpos 1
     vexactpos 1
     size 0.33333 53
     hexactsize 0
     vexactsize 1
     halign right_ref
     valign bottom_ref
     ignorepointer 1
     {
      ButtonWidgetClass closeBtn {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 1 1
       hexactsize 0
       vexactsize 0
       "text color" 0.9961 0.9961 0.9961 1
       style TXBtnDefault
       color 0.9961 0.9961 0.9961 1
       scriptclass "ButtonBinding"
       {
        TextWidgetClass closeBtnText {
         position 0 0
         hexactpos 0
         vexactpos 0
         size 1 1
         hexactsize 0
         vexactsize 0
         color 0.7608 0.7098 0.6118 1
         font "TraderX/datasets/fonts/antonpx20"
         ignorepointer 1
         "exact text" 1
         "text halign" center
         "text valign" center
         text "#tpm_close"
        }
       }
       {
        ScriptParamsClass {
         OnClick "OnCloseClick"
        }
       }
      }
     }
    }
   }
  }
 }
}