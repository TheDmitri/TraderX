PanelWidgetClass modalRoot {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 halign center_ref
 valign center_ref
 priority 999
 {
  PanelWidgetClass backdrop {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   color 0 0 0 0.7843
   style rover_sim_colorable
  }
  PanelWidgetClass modalCard {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 0.3 0.3
   hexactsize 0
   vexactsize 0
   halign center_ref
   valign center_ref
   style TXCard
   color 0.9961 0.9961 0.9961 1
   {
    TextWidgetClass title {
     position 0 0.08
     hexactpos 0
     vexactpos 0
     size 1 0.16
     hexactsize 0
     vexactsize 0
     halign center_ref
     color 0.8471 0.8235 0.7529 1
     font "TraderX/datasets/fonts/oswalt22"
     ignorepointer 1
     "exact text" 1
     "text halign" center
     "text valign" center
     text "#tpm_confirmation"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ title }}"
      }
     }
    }
    RichTextWidgetClass textContent {
     position 0.08 0.34
     hexactpos 0
     vexactpos 0
     size 0.84 0.34
     hexactsize 0
     vexactsize 0
     color 0.6588 0.6902 0.6549 1
     font "TraderX/datasets/fonts/oswalt16"
     ignorepointer 1
     wrap 1
     "exact text" 1
     "text halign" center
     text "Are you sure?"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ content }}"
      }
     }
    }
    ButtonWidgetClass cancelBtn {
     position 0.07 0.74
     hexactpos 0
     vexactpos 0
     size 0.4 0.18
     hexactsize 0
     vexactsize 0
     "text color" 0.9961 0.9961 0.9961 1
     style TXBtnDefault
     color 0.9961 0.9961 0.9961 1
     text "#tpm_cancel"
     scriptclass "ButtonBinding"
     {
      ScriptParamsClass {
       OnClick "OnCancelClick"
      }
     }
    }
    ButtonWidgetClass confirmBtn {
     position 0.53 0.74
     hexactpos 0
     vexactpos 0
     size 0.4 0.18
     hexactsize 0
     vexactsize 0
     "text color" 0.9961 0.9961 0.9961 1
     style TXBtnPrimary
     color 0.9961 0.9961 0.9961 1
     text "#tpm_confirm"
     scriptclass "ButtonBinding"
     {
      ScriptParamsClass {
       OnClick "OnConfirmClick"
      }
     }
    }
   }
  }
 }
}