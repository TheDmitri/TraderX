PanelWidgetClass searchBarRoot {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 style TXInputField
 color 0.9961 0.9961 0.9961 1
 {
  ImageWidgetClass searchHint {
   position 14 0
   hexactpos 1
   vexactpos 0
   size 19 19
   hexactsize 1
   vexactsize 1
   valign center_ref
   color 0.6392 0.5725 0.4627 1
   ignorepointer 1
   image0 "set:traderx_icons image:search"
   mode blend
   "src alpha" 1
   "stretch mode" stretch_w_h
  }
  TextWidgetClass searchPlaceholder {
   position 43 0
   hexactpos 1
   vexactpos 0
   size 0.8 1
   hexactsize 0
   vexactsize 0
   color 0.549 0.4902 0.4 1
   font "TraderX/datasets/fonts/rajdhanipx19"
   ignorepointer 1
   "exact text" 1
   "text valign" center
   text "#tpm_item_name"
  }
  EditBoxWidgetClass searchInput {
   position 43 0
   hexactpos 1
   vexactpos 0
   size 0.8 0.8
   hexactsize 0
   vexactsize 0
   valign center_ref
   color 0.949 0.9137 0.8471 1
   font "TraderX/datasets/fonts/rajdhanipx19"
   scriptclass "EditBoxBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ search_keyword }}"
     Two_Way_Binding 1
     OnChange "OnSearchChanged"
    }
   }
  }
 }
}