PanelWidgetClass slotTile {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 48 48
 hexactsize 1
 vexactsize 1
 ignorepointer 1
 {
  ButtonWidgetClass btnNav {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   "text color" 0.9961 0.9961 0.9961 1
   style TXBtnIcon
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ImageWidgetClass imgBtn {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 26 26
     hexactsize 1
     vexactsize 1
     halign center_ref
     valign center_ref
     color 0.6392 0.5725 0.4627 1
     ignorepointer 1
     image0 "set:traderx_icons image:allStock"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
   }
   {
    ScriptParamsClass {
     OnClick "OnSlotClick"
     OnRightClick "OnSlotRightClick"
     OnMouseEnter "OnSlotMouseEnter"
     OnMouseLeave "OnSlotMouseLeave"
    }
   }
  }
  TextWidgetClass slotCount {
   position 4 2
   hexactpos 1
   vexactpos 1
   size 40 16
   hexactsize 1
   vexactsize 1
   halign right_ref
   color 0.9098 0.5373 0.2902 1
   font "TraderX/datasets/fonts/monopx13"
   ignorepointer 1
   "exact text" 1
   "text halign" right
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ itemCount }}"
    }
   }
  }
  ImageWidgetClass imgLock {
   position 3 3
   hexactpos 1
   vexactpos 1
   size 13 13
   hexactsize 1
   vexactsize 1
   halign right_ref
   valign bottom_ref
   color 0.8784 0.4784 0.3882 1
   ignorepointer 1
   visible 0
   image0 "set:traderx_icons image:padlock"
   mode blend
   "src alpha" 1
   "stretch mode" stretch_w_h
  }
 }
}