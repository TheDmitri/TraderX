ButtonWidgetClass btnNav {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 52 52
 hexactsize 1
 vexactsize 1
 "text color" 0.9961 0.9961 0.9961 1
 style TXBtnIcon
 color 0.9961 0.9961 0.9961 1
 scriptclass "ButtonBinding"
 {
  ImageWidgetClass imgBtn {
   size 34 34
   hexactsize 1
   vexactsize 1
   halign center_ref
   valign center_ref
   color 0.1647 0.1647 0.1647 1
   ignorepointer 1
   hexactpos 0
   vexactpos 0
   image0 "set:traderx_icons image:allStock"
   mode blend
   "src alpha" 1
   "stretch mode" stretch_w_h
  }
  TextWidgetClass slotCount {
   position 0 0.01
   hexactpos 0
   vexactpos 0
   size 0.96 0.3
   hexactsize 0
   vexactsize 0
   "text color" 0.7686 0.6392 0.3529 1
   font "TraderX/datasets/fonts/jet-brains-mono12"
   ignorepointer 1
   style Bold
   "exact text" 1
   "text halign" right
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ itemCount }}"
    }
   }
  }
  ImageWidgetClass imgLock {
   size 15 15
   hexactsize 1
   vexactsize 1
   halign right_ref
   valign bottom_ref
   color 0.9412 0.3961 0.2902 1
   ignorepointer 1
   visible 0
   hexactpos 0
   vexactpos 0
   image0 "set:traderx_icons image:padlock"
   mode blend
   "src alpha" 1
   "stretch mode" stretch_w_h
  }
 }
 {
  ScriptParamsClass {
   OnClick "OnSlotClick"
   OnRightClick "OnSlotRightClick"
   OnMouseEnter "OnSlotMouseEnter"
   OnMouseLeave "OnSlotMouseLeave"
  }
 }
}