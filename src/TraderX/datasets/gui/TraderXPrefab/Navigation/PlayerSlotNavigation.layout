PanelWidgetClass PlayerSlotNavigation {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 ignorepointer 1
 {
  GridSpacerWidgetClass slotNavGrid {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 0.01
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   "Size To Content V" 1
   Columns 5
   Rows 100
   Padding 6
   scriptclass "ComponentWidgetBinding"
   {
    ScriptParamsClass {
     Component_ForEach "{{ _inputNavBtnIds }}"
     Component_Template "tx-player-slot-btn"
     Component_ItemProperty "_inputSlot"
    }
   }
  }
 }
}