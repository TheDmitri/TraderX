PanelWidgetClass presetCardView {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 300
 hexactsize 0
 vexactsize 1
 ignorepointer 1
 {
  PanelWidgetClass presetCardOutline {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXCardElevated
   color 0.9961 0.9961 0.9961 1
  }
  ButtonWidgetClass presetBtn {
   position 0.01 0.01
   hexactpos 0
   vexactpos 0
   size 0.98 0.98
   hexactsize 0
   vexactsize 0
   "text color" 0.9961 0.9961 0.9961 1
   style Empty
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnPresetClick"
    }
   }
  }
  PanelWidgetClass presetCardContent {
   position 0.01 0.01
   hexactpos 0
   vexactpos 0
   size 0.98 0.98
   hexactsize 0
   vexactsize 0
   color 0 0 0 0
   ignorepointer 1
   style rover_sim_colorable
   {
    PanelWidgetClass previewWell {
     position 0.04 0.03
     hexactpos 0
     vexactpos 0
     size 0.92 0.54
     hexactsize 0
     vexactsize 0
     color 0.0235 0.0275 0.0392 1
     ignorepointer 1
     style rover_sim_colorable
    }
    ItemPreviewWidgetClass presetPreview {
     position 0.08 0.05
     hexactpos 0
     vexactpos 0
     size 0.84 0.5
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     clipchildren 1
     priority 1
     scriptclass "ItemPreviewBinding"
     {
      ScriptParamsClass {
       Binding_Item "{{ preview }}"
      }
     }
    }
    PanelWidgetClass infoStrip {
     position 0 0.58
     hexactpos 0
     vexactpos 0
     size 1 0.42
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     style TXSurface
     color 0.9961 0.9961 0.9961 1
     {
      TextWidgetClass presetNameText {
       position 0.06 0.06
       hexactpos 0
       vexactpos 0
       size 0.88 0.34
       hexactsize 0
       vexactsize 0
       color 0.8471 0.8235 0.7529 1
       font "TraderX/datasets/fonts/oswalt16"
       ignorepointer 1
       style Bold
       "exact text" 1
       "text halign" center
       text "Preset Name"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ preset_name }}"
        }
       }
      }
      GridSpacerWidgetClass priceGrid {
       position 0.28 0.46
       hexactpos 0
       vexactpos 0
       size 0.4 0.32
       hexactsize 0
       vexactsize 0
       ignorepointer 1
       Columns 2
       Rows 1
       Margin 6
       "Size To Content H" 1
       {
        ImageWidgetClass priceIcon {
         position 0.28 0.46
         hexactpos 0
         vexactpos 0
         size 32 32
         hexactsize 1
         vexactsize 1
         color 0.7686 0.6392 0.3529 1
         ignorepointer 1
         image0 "set:traderx_icons image:simpleCoins"
         mode blend
         "src alpha" 1
         "stretch mode" stretch_w_h
        }
        TextWidgetClass priceText {
         position 0.38 0.42
         hexactpos 0
         vexactpos 0
         size 0.36 0.4
         hexactsize 0
         vexactsize 0
         color 0.7686 0.6392 0.3529 1
         font "TraderX/datasets/fonts/jet-brains-mono22"
         ignorepointer 1
         style Bold
         "exact text" 1
         "text valign" center
         "size to text h" 1
         text "1,250"
         scriptclass "TextBinding"
         {
          ScriptParamsClass {
           Binding_Expression "{{ price }}"
          }
         }
        }
       }
      }
     }
    }
   }
  }
  ButtonWidgetClass defaultPresetBtn {
   position 0.04 0.04
   hexactpos 0
   vexactpos 0
   size 24 24
   hexactsize 1
   vexactsize 1
   "text color" 0.9961 0.9961 0.9961 1
   style Empty
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ImageWidgetClass defaultPresetImg {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 1
     hexactsize 0
     vexactsize 0
     color 0.7451 0.7451 0.7451 0.7843
     ignorepointer 1
     image0 "set:traderx_icons image:favFull"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
   }
   {
    ScriptParamsClass {
     OnClick "OnDefaultPresetClick"
    }
   }
  }
  ButtonWidgetClass editBtn {
   position 0.8 0.04
   hexactpos 0
   vexactpos 0
   size 24 24
   hexactsize 1
   vexactsize 1
   "text color" 0.9961 0.9961 0.9961 1
   style Empty
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ImageWidgetClass editIcon {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 1
     hexactsize 0
     vexactsize 0
     color 0.6039 0.5804 0.5333 1
     ignorepointer 1
     image0 "set:traderx_icons image:edit"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
   }
   {
    ScriptParamsClass {
     OnClick "OnEditPresetClick"
    }
   }
  }
  ButtonWidgetClass deleteBtn {
   position 0.9 0.04
   hexactpos 0
   vexactpos 0
   size 24 24
   hexactsize 1
   vexactsize 1
   "text color" 0.9961 0.9961 0.9961 1
   style Empty
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ImageWidgetClass deleteIcon {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 1
     hexactsize 0
     vexactsize 0
     color 0.7686 0.3137 0.3098 1
     ignorepointer 1
     image0 "set:traderx_icons image:trash"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
   }
   {
    ScriptParamsClass {
     OnClick "OnDeletePresetClick"
    }
   }
  }
 }
}