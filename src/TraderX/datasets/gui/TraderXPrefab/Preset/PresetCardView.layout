PanelWidgetClass presetCardView {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 96
 hexactsize 0
 vexactsize 1
 ignorepointer 1
 style TXRowRule
 color 0.9961 0.9961 0.9961 1
 {
  ButtonWidgetClass presetBtn {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   "text color" 0.9961 0.9961 0.9961 1
   style TXListRow
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnPresetClick"
    }
   }
  }
  PanelWidgetClass presetCardContent {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   {
    PanelWidgetClass previewWell {
     position 24 14
     hexactpos 1
     vexactpos 1
     size 67 67
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     style TXInset
     color 0.9961 0.9961 0.9961 1
    }
    ItemPreviewWidgetClass presetPreview {
     position 25 15
     hexactpos 1
     vexactpos 1
     size 65 65
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     clipchildren 1
     scriptclass "ItemPreviewBinding"
     {
      ScriptParamsClass {
       Binding_Item "{{ preview }}"
      }
     }
    }
    TextWidgetClass presetNameText {
     position 0.19565 22
     hexactpos 0
     vexactpos 1
     size 0.47101 26
     hexactsize 0
     vexactsize 1
     color 0.949 0.9137 0.8471 1
     font "TraderX/datasets/fonts/rajdhanibpx20"
     ignorepointer 1
     "exact text" 1
     "text valign" center
     text "Preset - 2"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ preset_name }}"
      }
     }
    }
    WrapSpacerWidgetClass priceGrid {
     position 0.19565 50
     hexactpos 0
     vexactpos 1
     size 0.47101 22
     hexactsize 0
     vexactsize 1
     ignorepointer 1
     Padding 10
     {
      TextWidgetClass priceText {
       size 1 22
       hexactsize 1
       vexactsize 1
       color 0.9098 0.5373 0.2902 1
       font "TraderX/datasets/fonts/monopx18"
       ignorepointer 1
       "exact text" 1
       "text valign" center
       "size to text h" 1
       text "€ 670"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ price }}"
        }
       }
      }
      TextWidgetClass ownerText {
       size 1 22
       hexactsize 1
       vexactsize 1
       color 0.6392 0.5725 0.4627 1
       font "TraderX/datasets/fonts/rajdhanipx16"
       ignorepointer 1
       "exact text" 1
       "text valign" center
       "size to text h" 1
       text "server default"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ preset_owner }}"
        }
       }
      }
     }
    }
   }
  }
  PanelWidgetClass presetCardOutline {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 1
   vexactsize 1
   ignorepointer 1
   visible 0
  }
  ButtonWidgetClass defaultPresetBtn {
   position 0.22101 0
   hexactpos 0
   vexactpos 0
   size 41 41
   hexactsize 1
   vexactsize 1
   halign right_ref
   valign center_ref
   "text color" 0.9961 0.9961 0.9961 1
   style TXBtnIcon
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ImageWidgetClass defaultPresetImg {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 18 18
     hexactsize 1
     vexactsize 1
     halign center_ref
     valign center_ref
     color 0.7608 0.7098 0.6118 1
     ignorepointer 1
     image0 "set:traderx_icons image:star_full"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
   }
   {
    ScriptParamsClass {
     OnClick "OnDefaultPresetClick"
    }
   }
  }
  ButtonWidgetClass editBtn {
   position 0.13225 0
   hexactpos 0
   vexactpos 0
   size 41 41
   hexactsize 1
   vexactsize 1
   halign right_ref
   valign center_ref
   "text color" 0.9961 0.9961 0.9961 1
   style TXBtnIcon
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ImageWidgetClass editIcon {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 18 18
     hexactsize 1
     vexactsize 1
     halign center_ref
     valign center_ref
     color 0.7608 0.7098 0.6118 1
     ignorepointer 1
     image0 "set:traderx_icons image:edit"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
   }
   {
    ScriptParamsClass {
     OnClick "OnEditPresetClick"
    }
   }
  }
  ButtonWidgetClass deleteBtn {
   position 24 0
   hexactpos 1
   vexactpos 0
   size 41 41
   hexactsize 1
   vexactsize 1
   halign right_ref
   valign center_ref
   "text color" 0.9961 0.9961 0.9961 1
   style TXBtnIcon
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ImageWidgetClass deleteIcon {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 18 18
     hexactsize 1
     vexactsize 1
     halign center_ref
     valign center_ref
     color 0.8784 0.4784 0.3882 1
     ignorepointer 1
     image0 "set:traderx_icons image:trash"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
   }
   {
    ScriptParamsClass {
     OnClick "OnDeletePresetClick"
    }
   }
  }
 }
}