PanelWidgetClass NewPresetPanel {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 ignorepointer 1
 {
  ButtonWidgetClass newPresetBtn {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   "text color" 0.9961 0.9961 0.9961 1
   style TXBtnAccent
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnNewPresetClick"
    }
   }
  }
  PanelWidgetClass dashedBox {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 1
   vexactsize 1
   ignorepointer 1
   visible 0
  }
  ImageWidgetClass addIcon {
   position 0.31746 0
   hexactpos 0
   vexactpos 0
   size 17 17
   hexactsize 1
   vexactsize 1
   valign center_ref
   color 0.851 0.4627 0.1843 1
   ignorepointer 1
   image0 "set:traderx_icons image:add"
   mode blend
   "src alpha" 1
   "stretch mode" stretch_w_h
  }
  TextWidgetClass newPresetLabel {
   position 0.37302 0
   hexactpos 0
   vexactpos 0
   size 0.55556 58
   hexactsize 0
   vexactsize 1
   color 0.949 0.9137 0.8471 1
   font "TraderX/datasets/fonts/rajdhanibpx19"
   ignorepointer 1
