PanelWidgetClass NewPresetPanel {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 style blank
 color 0.9961 0.9961 0.9961 1
 {
  ButtonWidgetClass newPresetBtn {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   "text color" 0.9961 0.9961 0.9961 1
   style TXBtnDefault
   color 0.9961 0.9961 0.9961 1
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnNewPresetClick"
    }
   }
  }
  PanelWidgetClass dashedBox {
   position 0.04 0.02
   hexactpos 0
   vexactpos 0
   size 0.92 0.96
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style dashed
   color 0.9961 0.9961 0.9961 1
   {
    ImageWidgetClass addIcon {
     position 0 0.36
     hexactpos 0
     vexactpos 0
     size 36 36
     hexactsize 1
     vexactsize 1
     halign center_ref
     color 0.8471 0.8471 0.8471 1
     ignorepointer 1
     image0 "set:traderx_icons image:add"
     mode blend
     "src alpha" 1
     "stretch mode" stretch_w_h
    }
    TextWidgetClass newPresetLabel {
     position 0.04 0.52
     hexactpos 0
     vexactpos 0
     size 0.92 0.3
     hexactsize 0
     vexactsize 0
     halign center_ref
     color 0.8471 0.8235 0.7529 1
     font "TraderX/datasets/fonts/oswalt22"
     ignorepointer 1
     wrap 1
     "text halign" center
     text "#tpm_create_new_preset"
    }
   }
  }
 }
}