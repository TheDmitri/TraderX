PanelWidgetClass FavoritesView {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 color 0.0745 0.0627 0.0471 1
 ignorepointer 1
 style rover_sim_colorable
 {
  TextWidgetClass favTitle {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 1
   vexactsize 1
   color 0 0 0 0
   ignorepointer 1
   visible 0
   text "#tpm_favorites"
  }
  ScrollWidgetClass scrollCategory {
   position 29 24
   hexactpos 1
   vexactpos 1
   size 0.73229 902
   hexactsize 0
   vexactsize 1
   "Scrollbar V" 1
   {
    GridSpacerWidgetClass categoryGrid {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 0.01
     hexactsize 0
     vexactsize 0
     "Size To Content V" 1
     Columns 1
     Rows 100
     Padding 36
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_ForEach "{{ _inputCategories }}"
       Component_Template "tx-category-card"
       Component_ItemProperty "_inputCategory"
      }
     }
    }
   }
  }
  PanelWidgetClass SearchBarHost {
   position 0.44271 26
   hexactpos 0
   vexactpos 1
   size 0.17708 45
   hexactsize 0
   vexactsize 1
   halign right_ref
   scriptclass "ComponentWidgetBinding"
   {
    ScriptParamsClass {
     Component_Selector "tx-search-bar"
    }
   }
  }
  PanelWidgetClass ViewToggleHost {
   position 0.2526 28
   hexactpos 0
   vexactpos 1
   size 96 41
   hexactsize 1
   vexactsize 1
   halign right_ref
   ignorepointer 1
   scriptclass "ComponentWidgetBinding"
   {
    ScriptParamsClass {
     Component_Selector "tx-view-toggle"
    }
   }
  }
  PanelWidgetClass CheckoutHost {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 0.2375 950
   hexactsize 0
   vexactsize 1
   halign right_ref
   scriptclass "ComponentWidgetBinding"
   {
    ScriptParamsClass {
     Component_Selector "tx-checkout"
    }
   }
  }
 }
}