PanelWidgetClass PurchasePageView {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 ignorepointer 1
 style TXContent
 color 0.9961 0.9961 0.9961 1
 {
  PanelWidgetClass topBar {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 0.06
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXSurface
   color 0.9961 0.9961 0.9961 1
   {
    PanelWidgetClass SearchBarHost {
     position 0.36 0.22
     hexactpos 0
     vexactpos 0
     size 0.24 0.56
     hexactsize 0
     vexactsize 0
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_Selector "tx-search-bar"
      }
     }
    }
    ButtonWidgetClass toggleExpandBtn {
     position 0.6 0.22
     hexactpos 0
     vexactpos 0
     size 0.06 0.56
     hexactsize 0
     vexactsize 0
     "text color" 0.9961 0.9961 0.9961 1
     "text color" 0.8471 0.8235 0.7529 1
     font "TraderX/datasets/fonts/oswalt12"
     "exact text" 1
     style "TXBtnDefault"
     style Bold
     color 0.9961 0.9961 0.9961 1
     scriptclass "ButtonBinding"
     {
      TextWidgetClass toggleExpandText {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 1 1
       hexactsize 0
       vexactsize 0
       "text color" 0.8471 0.8235 0.7529 1
       font "TraderX/datasets/fonts/oswalt12"
       ignorepointer 1
       "text halign" center
       "text valign" center
       "exact text" 1
       text "#tpm_expand_all"
      }
     }
     {
      ScriptParamsClass {
       OnClick "OnToggleExpandClick"
      }
     }
    }
    PanelWidgetClass ViewToggleHost {
     position 0.67 0.22
     hexactpos 0
     vexactpos 0
     size 0.08 0.56
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_Selector "tx-view-toggle"
      }
     }
    }
   }
  }
  PanelWidgetClass PlayerPreviewPanel {
   position 0.01 0.07
   hexactpos 0
   vexactpos 0
   size 0.19 0.92
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXCard
   color 0.9961 0.9961 0.9961 1
   {
    PlayerPreviewWidgetClass playerPreview {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 0.94 0.75
     hexactsize 0
     vexactsize 0
     halign center_ref
     valign center_ref
     ignorepointer 1
     {
      ScriptParamsClass {
       Enable_Rotation 1
      }
     }
    }
    ButtonWidgetClass stripBtn {
     position 0.28 0.88
     hexactpos 0
     vexactpos 0
     size 44 44
     hexactsize 1
     vexactsize 1
     "text color" 0.9961 0.9961 0.9961 1
     "text color" 0.8471 0.8235 0.7529 1
     font "TraderX/datasets/fonts/oswalt16"
     "exact text" 1
     style TXBtnIcon
     color 0.9961 0.9961 0.9961 1
     scriptclass "ButtonBinding"
     {
      ImageWidgetClass stripBtnIcon {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 0.55 0.55
       hexactsize 0
       vexactsize 0
       halign center_ref
       valign center_ref
       ignorepointer 1
       image0 "set:traderx_icons image:person"
       mode blend
       "src alpha" 1
       "stretch mode" stretch_w_h
      }
     }
     {
      ScriptParamsClass {
       OnClick "OnStripClick"
      }
     }
    }
    ButtonWidgetClass resetBtn {
     position 0.56 0.88
     hexactpos 0
     vexactpos 0
     size 44 44
     hexactsize 1
     vexactsize 1
     "text color" 0.9961 0.9961 0.9961 1
     "text color" 0.8471 0.8235 0.7529 1
     font "TraderX/datasets/fonts/oswalt16"
     "exact text" 1
     style TXBtnIcon
     color 0.9961 0.9961 0.9961 1
     scriptclass "ButtonBinding"
     {
      ImageWidgetClass resetBtnIcon {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 0.55 0.55
       hexactsize 0
       vexactsize 0
       halign center_ref
       valign center_ref
       ignorepointer 1
       image0 "set:traderx_icons image:refresh"
       mode blend
       "src alpha" 1
       "stretch mode" stretch_w_h
      }
     }
     {
      ScriptParamsClass {
       OnClick "OnResetClick"
      }
     }
    }
   }
  }
  PanelWidgetClass CategoryListPanel {
   position 0.21 0.07
   hexactpos 0
   vexactpos 0
   size 0.55 0.92
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXSurface
   color 0.9961 0.9961 0.9961 1
   {
    ScrollWidgetClass scrollCategory {
     position 0.01 0.01
     hexactpos 0
     vexactpos 0
     size 0.98 0.98
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     "Scrollbar V" 1
     {
      GridSpacerWidgetClass categoryGrid {
       position 0 0
       hexactpos 0
       vexactpos 0
       size 1 0.01
       hexactsize 0
       vexactsize 0
       "Size To Content V" 1
       Columns 1
       Rows 100
       Margin 6
       scriptclass "ComponentWidgetBinding"
       {
        ScriptParamsClass {
         Component_ForEach "{{ _inputCategories }}"
         Component_Template "tx-category-card"
         Component_ItemProperty "_inputCategory"
        }
       }
      }
     }
    }
   }
  }
  PanelWidgetClass CheckoutHost {
   position 0.77 0.07
   hexactpos 0
   vexactpos 0
   size 0.22 0.92
   hexactsize 0
   vexactsize 0
   style TXCard
   color 0.9961 0.9961 0.9961 1
   scriptclass "ComponentWidgetBinding"
   {
    ScriptParamsClass {
     Component_Selector "tx-checkout"
    }
   }
  }
 }
}