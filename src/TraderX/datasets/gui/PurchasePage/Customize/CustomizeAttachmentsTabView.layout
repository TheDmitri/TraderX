PanelWidgetClass CustomizeAttachmentsTab {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 ignorepointer 1
 {
  ScrollWidgetClass attachmentsScroll {
   position 0 10
   hexactpos 0
   vexactpos 1
   size 1 700
   hexactsize 0
   vexactsize 1
   "Scrollbar V" 1
   {
    GridSpacerWidgetClass slotGrid {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 0.01
     hexactsize 0
     vexactsize 0
     "Size To Content V" 1
     Columns 1
     Rows 100
     Padding 0
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_ForEach "{{ _inputSlots }}"
       Component_Template "tx-customize-slot-row"
       Component_ItemProperty "_inputSlot"
      }
     }
    }
   }
  }
  PanelWidgetClass attachmentGridList {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 1
   vexactsize 1
   ignorepointer 1
   visible 0
  }
  PanelWidgetClass attachmentGridTiles {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 1
   vexactsize 1
   ignorepointer 1
   visible 0
  }
  TextWidgetClass emptyState {
   position 0 60
   hexactpos 0
   vexactpos 1
   size 1 30
   hexactsize 0
   vexactsize 1
   color 0.6392 0.5725 0.4627 1
   font "TraderX/datasets/fonts/rajdhanipx18"
   ignorepointer 1
   "exact text" 1
   "text halign" center
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ empty_label }}"
    }
   }
  }
  PanelWidgetClass presetChipsPanel {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 163
   hexactsize 0
   vexactsize 1
   halign left_ref
   valign bottom_ref
   ignorepointer 1
   {
    PanelWidgetClass presetChipsRule {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 1
     hexactsize 0
     vexactsize 1
     color 0.2275 0.1922 0.1529 1
     ignorepointer 1
     style rover_sim_colorable
    }
    TextWidgetClass presetChipsLabel {
     position 24 19
     hexactpos 1
     vexactpos 1
     size 0.54348 18
     hexactsize 0
     vexactsize 1
     color 0.6392 0.5725 0.4627 1
     font "TraderX/datasets/fonts/rajdhanibpx14"
     ignorepointer 1
     "exact text" 1
     "text valign" center
     text "YOUR PRESETS"
     scriptclass "TextBinding"
     {
      ScriptParamsClass {
       Binding_Expression "{{ presets_label }}"
      }
     }
    }
    GridSpacerWidgetClass presetChipsGrid {
     position 24 50
     hexactpos 1
     vexactpos 1
     size 0.91304 1
     hexactsize 0
     vexactsize 1
     "Size To Content V" 1
     Columns 2
     Rows 10
     Padding 12
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_ForEach "{{ _inputPresetChips }}"
       Component_Template "tx-customize-preset-chip"
       Component_ItemProperty "_inputPreset"
      }
     }
    }
   }
  }
 }
}