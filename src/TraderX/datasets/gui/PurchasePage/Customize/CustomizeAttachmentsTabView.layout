PanelWidgetClass CustomizeAttachmentsTab {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 ignorepointer 1
 style blank
 color 0.9961 0.9961 0.9961 1
 {
  PanelWidgetClass attachTopBar {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 0.08
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXSurface
   color 0.9961 0.9961 0.9961 1
   {
    PanelWidgetClass ViewToggleHost {
     position 0.9 0.18
     hexactpos 0
     vexactpos 0
     size 0.08 0.6
     hexactsize 0
     vexactsize 0
     ignorepointer 1
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_Selector "tx-view-toggle"
      }
     }
    }
   }
  }
  ScrollWidgetClass attachmentsScroll {
   position 0 0.09
   hexactpos 0
   vexactpos 0
   size 1 0.91
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   "Scrollbar V" 1
   {
    GridSpacerWidgetClass attachmentGridList {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 0.01
     hexactsize 0
     vexactsize 0
     "Size To Content V" 1
     Columns 1
     Rows 100
     Margin 4
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_ForEach "{{ _inputAttachments }}"
       Component_Template "tx-item-card-small"
       Component_ItemProperty "_inputProduct"
      }
     }
    }
    GridSpacerWidgetClass attachmentGridTiles {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 0.01
     hexactsize 0
     vexactsize 0
     "Size To Content V" 1
     Columns 5
     Rows 100
     Margin 6
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_ForEach "{{ _inputAttachments }}"
       Component_Template "tx-item-card-large"
       Component_ItemProperty "_inputProduct"
      }
     }
    }
   }
  }
  TextWidgetClass emptyState {
   position 0 0.4
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   halign center_ref
   color 0.5451 0.5608 0.6039 1
   font "TraderX/datasets/fonts/oswalt16"
   ignorepointer 1
   "text halign" center
   "text valign" center
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ empty_label }}"
    }
   }
  }
 }
}