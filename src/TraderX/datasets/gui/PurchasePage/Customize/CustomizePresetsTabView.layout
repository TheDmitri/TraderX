PanelWidgetClass CustomizePresetsTab {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 ignorepointer 1
 {
  PanelWidgetClass newPresetHost {
   position 24 24
   hexactpos 1
   vexactpos 1
   size 0.91304 58
   hexactsize 0
   vexactsize 1
   scriptclass "ComponentWidgetBinding"
   {
    ScriptParamsClass {
     Component_Selector "tx-new-preset-card"
    }
   }
  }
  ScrollWidgetClass presetsScroll {
   position 0 102
   hexactpos 0
   vexactpos 1
   size 1 775
   hexactsize 0
   vexactsize 1
   "Scrollbar V" 1
   {
    GridSpacerWidgetClass presetGrid {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 0.01
     hexactsize 0
     vexactsize 0
     "Size To Content V" 1
     Columns 1
     Rows 100
     Padding 0
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_ForEach "{{ _inputPresets }}"
       Component_Template "tx-preset-card"
       Component_ItemProperty "_inputPreset"
      }
     }
    }
   }
  }
  TextWidgetClass emptyState {
   position 0 130
   hexactpos 0
   vexactpos 1
   size 1 30
   hexactsize 0
   vexactsize 1
   color 0.6392 0.5725 0.4627 1
   font "TraderX/datasets/fonts/rajdhanipx18"
   ignorepointer 1
   "exact text" 1
   "text halign" center
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ empty_label }}"
    }
   }
  }
 }
}