PanelWidgetClass CustomizePresetsTab {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 ignorepointer 1
 style blank
 color 0.9961 0.9961 0.9961 1
 {
  PanelWidgetClass newPresetHost {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 0.14 1
   hexactsize 0
   vexactsize 0
   scriptclass "ComponentWidgetBinding"
   {
    ScriptParamsClass {
     Component_Selector "tx-new-preset-card"
    }
   }
  }
  ScrollWidgetClass presetsScroll {
   position 0.15 0
   hexactpos 0
   vexactpos 0
   size 0.85 1
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   "Scrollbar V" 1
   {
    GridSpacerWidgetClass presetGrid {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 0.01
     hexactsize 0
     vexactsize 0
     "Size To Content V" 1
     Columns 5
     Rows 100
     Margin 8
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_ForEach "{{ _inputPresets }}"
       Component_Template "tx-preset-card"
       Component_ItemProperty "_inputPreset"
      }
     }
    }
   }
  }
  TextWidgetClass emptyState {
   position 0.15 0.4
   hexactpos 0
   vexactpos 0
   size 0.85 0.1
   hexactsize 0
   vexactsize 0
   halign center_ref
   color 0.5451 0.5608 0.6039 1
   font "TraderX/datasets/fonts/oswalt16"
   ignorepointer 1
   "text halign" center
   "text valign" center
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ empty_label }}"
    }
   }
  }
 }
}