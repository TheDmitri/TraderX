PanelWidgetClass CustomizeVariantsTab {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 ignorepointer 1
 {
  ScrollWidgetClass variantsScroll {
   position 0 10
   hexactpos 0
   vexactpos 1
   size 1 870
   hexactsize 0
   vexactsize 1
   "Scrollbar V" 1
   {
    GridSpacerWidgetClass variantsGrid {
     position 0 0
     hexactpos 0
     vexactpos 0
     size 1 0.01
     hexactsize 0
     vexactsize 0
     "Size To Content V" 1
     Columns 1
     Rows 100
     Padding 0
     scriptclass "ComponentWidgetBinding"
     {
      ScriptParamsClass {
       Component_ForEach "{{ _inputVariants }}"
       Component_Template "tx-variant-card"
       Component_ItemProperty "_inputProduct"
      }
     }
    }
   }
  }
  TextWidgetClass emptyState {
   position 0 60
   hexactpos 0
   vexactpos 1
   size 1 30
   hexactsize 0
   vexactsize 1
   color 0.6392 0.5725 0.4627 1
   font "TraderX/datasets/fonts/rajdhanipx18"
   ignorepointer 1
   "exact text" 1
   "text halign" center
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ empty_label }}"
    }
   }
  }
 }
}