GameProjectClass {
	ID "TraderX"
	TITLE "TraderX"
	Configurations {
		GameProjectConfigClass PC {
			platformHardware PC
			skeletonDefinitions "DZ/Anims/cfg/skeletons.anim.xml"
			FileSystem {
				FileSystemPathClass {
					Name "Workdrive"
					Directory "P:/"
				} 
			}
			imageSets {
				"gui/imagesets/ccgui_enforce.imageset"
				"gui/imagesets/rover_imageset.imageset"
				"gui/imagesets/dayz_gui.imageset"
				"gui/imagesets/dayz_crosshairs.imageset"
				"gui/imagesets/dayz_inventory.imageset"
				"gui/imagesets/inventory_icons.imageset"
				"gui/imagesets/main_menu_newsfeed.imageset"
				"gui/imagesets/smart_panel.imageset"
				"gui/imagesets/GUI_back_alpha.imageset"
				"gui/imagesets/GUI_back_alpha_icon.imageset"
				"gui/imagesets/xbox_buttons.imageset"
				"gui/imagesets/playstation_buttons.imageset"
				"gui/imagesets/selection.imageset"
				"gui/imagesets/console_toolbar.imageset"
				"TraderX_GUI/gui/Data/square_shadow.imageset"
				"TraderX_GUI/gui/Data/first.imageset"
				"TraderX/datasets/images/notification_ui.imageset"
				"TraderX/datasets/traderplus_ui.imageset"
				"TraderX/datasets/styles/traderx_ui.imageset"
				"TraderX/datasets/icons/traderx_icons.imageset"
				"CourseBarterTrader/datasets/gui/barter_trader_ui_ui.imageset"
			}
			widgetStyles {
				"gui/looknfeel/dayzwidgets.styles" 
				"gui/looknfeel/widgets.styles"
				"TraderX_GUI/gui/Styles.styles"
				"TraderX/datasets/Styles.styles"
				"TraderX/datasets/styles/traderx_styles.styles"
				"CourseBarterTrader/datasets/gui/barter_trader_ui_styles.styles"
			}
			ScriptModules {
				ScriptModulePathClass {
					Name "core"
					Paths {
						"scripts/1_Core"
						"DayZular/scripts/1_Core"
					}
					EntryPoint ""
				}
				ScriptModulePathClass {
					Name "gameLib"
					Paths {
						"scripts/2_GameLib"
						"DayZular/scripts/2_GameLib"
					}
					EntryPoint ""
				}
				ScriptModulePathClass {
					Name "game"
					Paths {
						"scripts/3_Game"
						"DayZular/scripts/3_Game"
					}
					EntryPoint "CreateGame"
				}
				ScriptModulePathClass {
					Name "world"
					Paths {
						"scripts/4_World"
						"DayZular/scripts/4_World"
					}
					EntryPoint ""
				}
				ScriptModulePathClass {
					Name "mission"
					Paths {
						"scripts/5_Mission"
						"DayZular/scripts/5_Mission"
					}
					EntryPoint "CreateMission"
				}
				
				ScriptModulePathClass {
					Name "workbench"
					Paths {
					} 
					EntryPoint "CreateWorkbench"
				} 
			}
		}
		GameProjectConfigClass XBOX_ONE {
			platformHardware XBOX_ONE
		}
		GameProjectConfigClass PS4 {
			platformHardware PS4
		}
		GameProjectConfigClass LINUX {
			platformHardware LINUX
		}
	}
}
