     vexactpos 1
     size 3 1
     hexactsize 1
     vexactsize 0
     color 0.6902 0.2824 0.1647 1
     ignorepointer 1
     style rover_sim_colorable
    }
    TextWidgetClass countdownLabel {
     position 16 0
     hexactpos 1
     vexactpos 1
     size 352 1
     hexactsize 1
