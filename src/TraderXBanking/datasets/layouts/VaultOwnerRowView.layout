PanelWidgetClass vaultOwnerRoot {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 style TXListRow
 color 0.9961 0.9961 0.9961 1
 {
  ButtonWidgetClass ownerRowClickBtn {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   color 0 0 0 0
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnOwnerRowClicked"
    }
   }
  }
  TextWidgetClass ownerRowName {
   position 0.03 0.15
   hexactpos 0
   vexactpos 0
   size 0.65 0.35
   hexactsize 0
   vexactsize 0
   "text color" 0.8471 0.8235 0.7529 1
   font "TraderX/datasets/fonts/oswalt14"
   ignorepointer 1
   "exact text" 1
   style Bold
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ ownerName }}"
    }
   }
  }
  TextWidgetClass ownerRowSub {
   position 0.03 0.5
   hexactpos 0
   vexactpos 0
   size 0.65 0.35
   hexactsize 0
   vexactsize 0
   "text color" 0.4157 0.3961 0.3765 1
   font "TraderX/datasets/fonts/oswalt12"
   ignorepointer 1
   "exact text" 1
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ ownerSub }}"
    }
   }
  }
  TextWidgetClass ownerRowBadge {
   position 0.7 0.25
   hexactpos 0
   vexactpos 0
   size 0.28 0.5
   hexactsize 0
   vexactsize 0
   "text color" 0.8314 0.6431 0.298 1
   font "TraderX/datasets/fonts/oswalt12"
   ignorepointer 1
   "exact text" 1
   "text halign" right
   "text valign" center
   style Bold
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ ownerBadge }}"
    }
   }
  }
 }
}