PanelWidgetClass vaultOwnerRoot {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 style TXBListRow
 color 0.9961 0.9961 0.9961 1
 {
  ButtonWidgetClass ownerRowClickBtn {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   color 0 0 0 0
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnOwnerRowClicked"
    }
   }
  }
  TextWidgetClass ownerRowName {
   position 0.03 0.15
   hexactpos 0
   vexactpos 0
   size 0.65 0.35
   hexactsize 0
   vexactsize 0
   color 0.949 0.9137 0.8471 1
   font "TraderX/datasets/fonts/rajdhanibpx18"
   ignorepointer 1
   "exact text" 1
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ ownerName }}"
    }
   }
  }
  TextWidgetClass ownerRowSub {
   position 0.03 0.5
   hexactpos 0
   vexactpos 0
   size 0.65 0.35
   hexactsize 0
   vexactsize 0
   color 0.549 0.4902 0.4 1
   font "TraderX/datasets/fonts/rajdhanibpx16"
   ignorepointer 1
   "exact text" 1
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ ownerSub }}"
    }
   }
  }
  TextWidgetClass ownerRowBadge {
   position 0.7 0.25
   hexactpos 0
   vexactpos 0
   size 0.28 0.5
   hexactsize 0
   vexactsize 0
   color 0.9098 0.5373 0.2902 1
   font "TraderX/datasets/fonts/rajdhanibpx16"
   ignorepointer 1
   "exact text" 1
   "text halign" right
   "text valign" center
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ ownerBadge }}"
    }
   }
  }
 }
}