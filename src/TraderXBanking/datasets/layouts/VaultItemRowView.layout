PanelWidgetClass vaultSlotRoot {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 style TXSurface
 color 0.9961 0.9961 0.9961 1
 {
  ButtonWidgetClass slotClickBtn {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   color 0 0 0 0
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnSlotClicked"
    }
   }
  }
  PanelWidgetClass slotHealth {
   position 0.05 0.05
   hexactpos 0
   vexactpos 0
   size 0.12 0.12
   hexactsize 0
   vexactsize 0
   ignorepointer 1
  }
  TextWidgetClass slotQty {
   position 0.7 0.05
   hexactpos 0
   vexactpos 0
   size 0.25 0.12
   hexactsize 0
   vexactsize 0
   "text color" 0.8314 0.6431 0.298 1
   font "TraderX/datasets/fonts/oswalt12"
   ignorepointer 1
   "exact text" 1
   "text halign" right
   style Bold
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ qtyText }}"
    }
   }
  }
  TextWidgetClass slotDepositor {
   position 0.7 0.2
   hexactpos 0
   vexactpos 0
   size 0.25 0.12
   hexactsize 0
   vexactsize 0
   "text color" 0.4157 0.3961 0.3765 1
   font "TraderX/datasets/fonts/oswalt12"
   ignorepointer 1
   "exact text" 1
   "text halign" right
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ depositorInitials }}"
    }
   }
  }
  TextWidgetClass slotFootprint {
   position 0.65 0.82
   hexactpos 0
   vexactpos 0
   size 0.3 0.1
   hexactsize 0
   vexactsize 0
   "text color" 0.4157 0.3961 0.3765 1
   font "TraderX/datasets/fonts/oswalt12"
   ignorepointer 1
   "exact text" 1
   "text halign" right
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ footprintText }}"
    }
   }
  }
  TextWidgetClass slotName {
   position 0.05 0.72
   hexactpos 0
   vexactpos 0
   size 0.6 0.22
   hexactsize 0
   vexactsize 0
   "text color" 0.8471 0.8235 0.7529 1
   font "TraderX/datasets/fonts/oswalt12"
   ignorepointer 1
   "exact text" 1
   style Bold
   wrap 1
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ displayName }}"
    }
   }
  }
 }
}