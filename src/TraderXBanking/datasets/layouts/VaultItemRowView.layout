PanelWidgetClass vaultSlotRoot {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 style TXBSurface
 color 0.9961 0.9961 0.9961 1
 {
  ButtonWidgetClass slotClickBtn {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   color 0 0 0 0
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnSlotClicked"
    }
   }
  }
  PanelWidgetClass slotHealth {
   position 0.05 0.05
   hexactpos 0
   vexactpos 0
   size 0.12 0.12
   hexactsize 0
   vexactsize 0
   ignorepointer 1
  }
  TextWidgetClass slotQty {
   position 0.7 0.05
   hexactpos 0
   vexactpos 0
   size 0.25 0.12
   hexactsize 0
   vexactsize 0
   color 0.9098 0.5373 0.2902 1
   font "TraderX/datasets/fonts/rajdhanibpx16"
   ignorepointer 1
   "exact text" 1
   "text halign" right
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ qtyText }}"
    }
   }
  }
  TextWidgetClass slotDepositor {
   position 0.7 0.2
   hexactpos 0
   vexactpos 0
   size 0.25 0.12
   hexactsize 0
   vexactsize 0
   color 0.549 0.4902 0.4 1
   font "TraderX/datasets/fonts/rajdhanibpx16"
   ignorepointer 1
   "exact text" 1
   "text halign" right
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ depositorInitials }}"
    }
   }
  }
  TextWidgetClass slotFootprint {
   position 0.65 0.82
   hexactpos 0
   vexactpos 0
   size 0.3 0.1
   hexactsize 0
   vexactsize 0
   color 0.549 0.4902 0.4 1
   font "TraderX/datasets/fonts/rajdhanibpx16"
   ignorepointer 1
   "exact text" 1
   "text halign" right
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ footprintText }}"
    }
   }
  }
  TextWidgetClass slotName {
   position 0.05 0.72
   hexactpos 0
   vexactpos 0
   size 0.6 0.22
   hexactsize 0
   vexactsize 0
   color 0.949 0.9137 0.8471 1
   font "TraderX/datasets/fonts/rajdhanibpx16"
   ignorepointer 1
   "exact text" 1
   wrap 1
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ displayName }}"
    }
   }
  }
 }
}