PanelWidgetClass activityRowRoot {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 color 0 0 0 0
 style rover_sim_colorable
 {
  TextWidgetClass activityDate {
   position 0.02 0
   hexactpos 0
   vexactpos 0
   size 0.12 1
   hexactsize 0
   vexactsize 0
   color 0.4157 0.3961 0.3765 1
   font "TraderX/datasets/fonts/oswalt12"
   ignorepointer 1
   "exact text" 1
   "text valign" center
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ activityDateText }}"
    }
   }
  }
  TextWidgetClass activityWho {
   position 0.15 0
   hexactpos 0
   vexactpos 0
   size 0.2 1
