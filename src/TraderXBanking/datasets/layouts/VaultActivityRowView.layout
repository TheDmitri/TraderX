   font "TraderX/datasets/fonts/oswalt12"
   ignorepointer 1
   "exact text" 1
   "text valign" center
   style Bold
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ activityWhoText }}"
    }
   }
  }
  TextWidgetClass activityDesc {
   position 0.36 0
   hexactpos 0
   vexactpos 0
   size 0.45 1
   hexactsize 0
   vexactsize 0
   color 0.6039 0.5804 0.5333 1
   font "TraderX/datasets/fonts/oswalt12"
   ignorepointer 1
   "exact text" 1
   "text valign" center
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ activityDescText }}"
    }
   }
  }
  TextWidgetClass activityDelta {
   position 0.82 0
   hexactpos 0
   vexactpos 0
   size 0.15 1
   hexactsize 0
   vexactsize 0
   color 0.6039 0.5804 0.5333 1
   font "TraderX/datasets/fonts/oswalt12"
   ignorepointer 1
   "exact text" 1
   "text valign" center
   "text halign" right
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ activityDeltaText }}"
    }
   }
  }
 }
