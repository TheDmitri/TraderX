  EditBoxWidgetClass ledgerSearchInput {
   position 0.02 0.02
   hexactpos 0
   vexactpos 0
   size 0.2 0.05
   hexactsize 0
   vexactsize 0
   "text color" 0.8471 0.8235 0.7529 1
   font "TraderX/datasets/fonts/oswalt12"
   "exact text" 1
   style TXInputField
   color 0.9961 0.9961 0.9961 1
   scriptclass "EditBoxBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ ledgerSearch }}"
     Two_Way_Binding 1
     OnChange "OnSearchChanged"
    }
   }
  }
