  PanelWidgetClass activityCard {
   position 0.02 0.27
   hexactpos 0
   vexactpos 0
   size 0.61 0.7
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXCard
   color 0.9961 0.9961 0.9961 1
   {
    TextWidgetClass activityTitle {
     position 0.02 0.03
     hexactpos 0
     vexactpos 0
     size 0.4 0.07
     hexactsize 0
     vexactsize 0
     color 0.8471 0.8235 0.7529 1
     font "TraderX/datasets/fonts/oswalt14"
     ignorepointer 1
     "exact text" 1
     style Bold
     text "RECENT ACTIVITY"
    }
    ButtonWidgetClass activityViewAll {
     position 0.78 0.02
     hexactpos 0
     vexactpos 0
     size 0.2 0.08
     hexactsize 0
     vexactsize 0
     "text color" 0.8314 0.6431 0.298 1
     font "TraderX/datasets/fonts/oswalt12"
     "exact text" 1
     style Bold
     style TXTab
     color 0.9961 0.9961 0.9961 1
     text "VIEW ALL >"
     scriptclass "NavButtonBinding"
     {
      ScriptParamsClass {
       TargetSelector "txb-ledger-tab"
      }
     }
    }
    ScrollWidgetClass activityScroll {
     position 0.02 0.12
     hexactpos 0
     vexactpos 0
     size 0.96 0.86
     hexactsize 0
     vexactsize 0
     "Scrollbar V" 1
     {
      GridSpacerWidgetClass activityList {
       size 1 44
       hexactsize 0
       vexactsize 1
       ignorepointer 1
       "Size To Content V" 1
       Columns 1
       Rows 20
       Margin 1
       scriptclass "ComponentWidgetBinding"
       {
        ScriptParamsClass {
         Component_ForEach "{{ recentEntries }}"
         Component_Template "txb-ledger-row"
         Component_ItemProperty "_inputEntry"
        }
       }
      }
      TextWidgetClass activityEmpty {
       position 0.05 0.38
       hexactpos 0
       vexactpos 0
       size 0.9 0.1
       hexactsize 0
       vexactsize 0
       color 0.4157 0.3961 0.3765 1
       font "TraderX/datasets/fonts/oswalt12"
       ignorepointer 1
       "exact text" 1
       "text halign" center
       "text valign" center
       text "No recent activity"
       scriptclass "TextBinding"
       {
        ScriptParamsClass {
         Binding_Expression "{{ activityEmptyText }}"
        }
       }
      }
     }
    }
   }
  }
