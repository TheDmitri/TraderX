     }
    }
    ButtonWidgetClass takeAllBtn {
     position 0.05 0.58
     hexactpos 0
     vexactpos 0
     size 0.9 0.16
     hexactsize 0
     vexactsize 0
     "text color" 0.7843 0.4 0.2902 1
     font "TraderX/datasets/fonts/oswalt12"
     "exact text" 1
     style Bold
     style TXBtnDanger
     color 0.9961 0.9961 0.9961 1
     text "TAKE EVERYTHING"
     scriptclass "ButtonBinding"
     {
      ScriptParamsClass {
       OnClick "OnTakeAll"
      }
     }
    }
    TextWidgetClass actionsNote {
     position 0.05 0.78
     hexactpos 0
     vexactpos 0
     size 0.9 0.2
     hexactsize 0
     vexactsize 0
     color 0.4157 0.3961 0.3765 1
     font "TraderX/datasets/fonts/oswalt12"
     ignorepointer 1
