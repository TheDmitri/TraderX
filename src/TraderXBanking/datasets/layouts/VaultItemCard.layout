PanelWidgetClass vaultCardRoot {
 position 0 0
 hexactpos 0
 vexactpos 0
 size 1 1
 hexactsize 0
 vexactsize 0
 style TXBSurface
 color 0.9961 0.9961 0.9961 1
 {
  ButtonWidgetClass cardClickBtn {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 1 1
   hexactsize 0
   vexactsize 0
   color 0 0 0 0
   scriptclass "ButtonBinding"
   {
    ScriptParamsClass {
     OnClick "OnCardClicked"
    }
   }
  }
  PanelWidgetClass cardStrip {
   position 0 0
   hexactpos 0
   vexactpos 0
   size 0.01 1
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   style TXBProgressFill
   color 0.9961 0.9961 0.9961 1
  }
  ItemPreviewWidgetClass cardPreview {
   position 0.63 0.02
   hexactpos 0
   vexactpos 0
   size 0.35 0.96
   hexactsize 0
   vexactsize 0
   ignorepointer 1
   scriptclass "ItemPreviewBinding"
   {
    ScriptParamsClass {
     Binding_Item "{{ entityRef }}"
     Enable_Rotation 1
    }
   }
  }
  TextWidgetClass cardName {
   position 0.03 0.05
   hexactpos 0
   vexactpos 0
   size 0.57 0.4
   hexactsize 0
   vexactsize 0
   color 0.949 0.9137 0.8471 1
   font "TraderX/datasets/fonts/rajdhanibpx16"
   ignorepointer 1
   "exact text" 1
   wrap 1
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ displayName }}"
    }
   }
  }
  TextWidgetClass cardQty {
   position 0.03 0.5
   hexactpos 0
   vexactpos 0
   size 0.3 0.18
   hexactsize 0
   vexactsize 0
   color 0.9098 0.5373 0.2902 1
   font "TraderX/datasets/fonts/rajdhanibpx16"
   ignorepointer 1
   "exact text" 1
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ qtyText }}"
    }
   }
  }
  TextWidgetClass cardHealth {
   position 0.03 0.7
   hexactpos 0
   vexactpos 0
   size 0.42 0.25
   hexactsize 0
   vexactsize 0
   color 0.9098 0.5373 0.2902 1
   font "TraderX/datasets/fonts/rajdhanibpx16"
   ignorepointer 1
   "exact text" 1
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ healthText }}"
    }
   }
  }
  TextWidgetClass cardFootprint {
   position 0.44 0.72
   hexactpos 0
   vexactpos 0
   size 0.17 0.22
   hexactsize 0
   vexactsize 0
   color 0.549 0.4902 0.4 1
   font "TraderX/datasets/fonts/rajdhanibpx16"
   ignorepointer 1
   "exact text" 1
   "text halign" right
   text "-"
   scriptclass "TextBinding"
   {
    ScriptParamsClass {
     Binding_Expression "{{ footprintText }}"
    }
   }
  }
 }
}